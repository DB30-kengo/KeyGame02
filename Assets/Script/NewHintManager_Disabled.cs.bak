using UnityEngine;

/// <summary>
/// 新しいシンプルヒントシステムの統合マネージャー
/// 複数のヒント表示方式から選択して使用可能
/// </summary>
public class NewHintManager : MonoBehaviour
{
    [Header("ヒント表示方式")]
    [Tooltip("使用するヒント表示方式を選択")]
    public HintDisplayType displayType = HintDisplayType.Notification;
    
    [Header("設定")]
    [Tooltip("ヒント表示キー")]
    public KeyCode hintKey = KeyCode.H;
    
    [Tooltip("自動セットアップ")]
    public bool autoSetup = true;
    
    [Tooltip("継続的な古いシステム監視")]
    public bool continuousOldSystemCheck = true;
    
    // ヒント表示コンポーネント
    private SimpleHintDisplay simpleHint;
    private MinimalHintDisplay minimalHint;
    private NotificationHintSystem notificationHint;
    
    // 監視用
    private float lastOldSystemCheckTime = 0f;
    private const float OLD_SYSTEM_CHECK_INTERVAL = 2f; // 2秒間隔でチェック
    
    public enum HintDisplayType
    {
        Simple,        // パネル表示（カスタマイズ可能）
        Minimal,       // 最小限のGUI表示
        Notification   // 通知スタイル（推奨）
    }
    
    void Start()
    {
        // 最優先で古いシステムを無効化（Startより早く実行されるAwakeでも対応）
        DisableOldHintSystems();
        
        if (autoSetup)
        {
            SetupHintSystem();
        }
        
        Debug.Log($"[NewHintManager] 新しいヒントシステム開始 - 表示方式: {displayType}");
    }
    
    void Awake()
    {
        // 他のStartメソッドより早く実行されるように、Awakeでも古いシステムを無効化
        Debug.Log("[NewHintManager] Awakeで古いヒントシステムを事前無効化");
        DisableOldHintSystems();
    }
    
    void Update()
    {
        // 継続的な古いシステム監視
        if (continuousOldSystemCheck && Time.time - lastOldSystemCheckTime > OLD_SYSTEM_CHECK_INTERVAL)
        {
            CheckAndDisableOldSystems();
            lastOldSystemCheckTime = Time.time;
        }
        
        // 表示方式の動的切り替え（テスト用）
        if (Input.GetKeyDown(KeyCode.F9))
        {
            SwitchToNextDisplayType();
        }
    }
    
    /// <summary>
    /// 古いシステムが復活していないかチェックして無効化
    /// </summary>
    void CheckAndDisableOldSystems()
    {
        bool foundOldSystem = false;
        
        // RealHintSystemが有効になっていないかチェック
        RealHintSystem realHint = FindObjectOfType<RealHintSystem>();
        if (realHint != null && realHint.enabled)
        {
            realHint.enabled = false;
            realHint.gameObject.SetActive(false);
            foundOldSystem = true;
            Debug.Log("[NewHintManager] RealHintSystemを再度無効化しました");
        }
        
        // 古いヒント用UIが表示されていないかチェック
        GameObject hintSystemContainer = GameObject.Find("RealHintSystemContainer");
        if (hintSystemContainer != null && hintSystemContainer.activeInHierarchy)
        {
            hintSystemContainer.SetActive(false);
            foundOldSystem = true;
            Debug.Log("[NewHintManager] RealHintSystemContainerを再度非表示にしました");
        }
        
        if (foundOldSystem)
        {
            Debug.Log("[NewHintManager] 古いヒントシステムの復活を検知して無効化しました");
        }
    }
    
    /// <summary>
    /// ヒントシステムをセットアップ
    /// </summary>
    void SetupHintSystem()
    {
        // 既存のヒントコンポーネントを無効化
        DisableOldHintSystems();
        
        // 選択されたヒント表示方式を有効化
        switch (displayType)
        {
            case HintDisplayType.Simple:
                SetupSimpleHint();
                break;
                
            case HintDisplayType.Minimal:
                SetupMinimalHint();
                break;
                
            case HintDisplayType.Notification:
                SetupNotificationHint();
                break;
        }
    }
    
    /// <summary>
    /// 古いヒントシステムを無効化
    /// </summary>
    void DisableOldHintSystems()
    {
        // 複雑な既存システムを無効化
        RealHintSystem oldRealHint = FindObjectOfType<RealHintSystem>();
        if (oldRealHint != null)
        {
            oldRealHint.enabled = false;
            // GameObjectも非アクティブ化
            oldRealHint.gameObject.SetActive(false);
            Debug.Log("[NewHintManager] RealHintSystemを無効化・非アクティブ化しました");
        }
        
        HintSystemLauncher oldLauncher = FindObjectOfType<HintSystemLauncher>();
        if (oldLauncher != null)
        {
            oldLauncher.enabled = false;
            Debug.Log("[NewHintManager] HintSystemLauncherを無効化しました");
        }
        
        // HintSceneTransitionも無効化
        HintSceneTransition oldTransition = FindObjectOfType<HintSceneTransition>();
        if (oldTransition != null)
        {
            oldTransition.enabled = false;
            Debug.Log("[NewHintManager] HintSceneTransitionを無効化しました");
        }
        
        // 既存のヒント関連UIを非表示
        DisableOldHintUI();
        
        // 古いヒント関連のCanvasを無効化
        DisableOldHintCanvas();
    }
    
    /// <summary>
    /// 古いヒント関連UIを無効化
    /// </summary>
    void DisableOldHintUI()
    {
        // 様々な可能な名前のヒントボタンを探して無効化
        string[] hintButtonNames = {
            "HintButton", "Hint Button", "hint button",
            "HintBtn", "Hint_Button", "Button_Hint"
        };
        
        foreach (string buttonName in hintButtonNames)
        {
            GameObject hintButton = GameObject.Find(buttonName);
            if (hintButton != null)
            {
                hintButton.SetActive(false);
                Debug.Log($"[NewHintManager] {buttonName}を非表示にしました");
            }
        }
        
        // ヒントパネルも無効化
        string[] hintPanelNames = {
            "HintPanel", "Hint Panel", "HintUI", "Hint_Panel"
        };
        
        foreach (string panelName in hintPanelNames)
        {
            GameObject hintPanel = GameObject.Find(panelName);
            if (hintPanel != null)
            {
                hintPanel.SetActive(false);
                Debug.Log($"[NewHintManager] {panelName}を非表示にしました");
            }
        }
    }
    
    /// <summary>
    /// 古いヒント専用Canvasを無効化
    /// </summary>
    void DisableOldHintCanvas()
    {
        // RealHintSystemが作成する可能性のあるCanvasを無効化
        string[] hintCanvasNames = {
            "HintSystemCanvas", "RealHintSystemContainer", "HintCanvas"
        };
        
        foreach (string canvasName in hintCanvasNames)
        {
            GameObject hintCanvas = GameObject.Find(canvasName);
            if (hintCanvas != null)
            {
                hintCanvas.SetActive(false);
                Debug.Log($"[NewHintManager] {canvasName}を非表示にしました");
            }
        }
        
        // 動的に作成されたヒント用Canvasも探して無効化
        Canvas[] allCanvases = FindObjectsOfType<Canvas>();
        foreach (Canvas canvas in allCanvases)
        {
            if (canvas.name.Contains("Hint") && canvas.gameObject.activeInHierarchy)
            {
                // RealHintSystemコンポーネントがある場合は無効化
                if (canvas.GetComponentInChildren<RealHintSystem>() != null)
                {
                    canvas.gameObject.SetActive(false);
                    Debug.Log($"[NewHintManager] ヒント用Canvas '{canvas.name}'を非表示にしました");
                }
            }
        }
    }
    
    /// <summary>
    /// 古いヒントシステムの完全無効化（GameObject破棄）
    /// </summary>
    public void DestroyOldHintSystems()
    {
        // より強力な対策：古いシステムを完全に破棄
        RealHintSystem[] oldRealHints = FindObjectsOfType<RealHintSystem>();
        foreach (RealHintSystem oldSystem in oldRealHints)
        {
            if (oldSystem.gameObject != this.gameObject) // 自分自身は破棄しない
            {
                Debug.Log($"[NewHintManager] RealHintSystemを完全破棄: {oldSystem.gameObject.name}");
                DestroyImmediate(oldSystem.gameObject);
            }
        }
        
        HintSystemLauncher[] oldLaunchers = FindObjectsOfType<HintSystemLauncher>();
        foreach (HintSystemLauncher oldLauncher in oldLaunchers)
        {
            Debug.Log($"[NewHintManager] HintSystemLauncherを完全破棄: {oldLauncher.gameObject.name}");
            DestroyImmediate(oldLauncher.gameObject);
        }
    }
    
    /// <summary>
    /// 緊急時：古いシステムを強制的に停止
    /// </summary>
    [ContextMenu("古いヒントシステムを強制無効化")]
    public void ForceDisableOldSystems()
    {
        Debug.Log("[NewHintManager] 古いヒントシステムの強制無効化を実行");
        DisableOldHintSystems();
        CheckAndDisableOldSystems();
        
        // さらに強力な対策
        DestroyOldHintSystems();
        
        Debug.Log("[NewHintManager] 古いヒントシステムの強制無効化完了");
    }

    void SetupSimpleHint()
    {
        simpleHint = gameObject.GetComponent<SimpleHintDisplay>();
        if (simpleHint == null)
        {
            simpleHint = gameObject.AddComponent<SimpleHintDisplay>();
        }
        
        simpleHint.hintKey = hintKey;
        simpleHint.enabled = true;
        
        Debug.Log("[NewHintManager] SimpleHintDisplayをセットアップしました");
    }
    
    void SetupMinimalHint()
    {
        minimalHint = gameObject.GetComponent<MinimalHintDisplay>();
        if (minimalHint == null)
        {
            minimalHint = gameObject.AddComponent<MinimalHintDisplay>();
        }
        
        minimalHint.hintKey = hintKey;
        minimalHint.enabled = true;
        
        Debug.Log("[NewHintManager] MinimalHintDisplayをセットアップしました");
    }
    
    void SetupNotificationHint()
    {
        notificationHint = gameObject.GetComponent<NotificationHintSystem>();
        if (notificationHint == null)
        {
            notificationHint = gameObject.AddComponent<NotificationHintSystem>();
        }
        
        notificationHint.hintKey = hintKey;
        notificationHint.enabled = true;
        
        Debug.Log("[NewHintManager] NotificationHintSystemをセットアップしました");
    }
    
    /// <summary>
    /// 次の表示方式に切り替え
    /// </summary>
    void SwitchToNextDisplayType()
    {
        // 現在のコンポーネントを無効化
        if (simpleHint != null) simpleHint.enabled = false;
        if (minimalHint != null) minimalHint.enabled = false;
        if (notificationHint != null) notificationHint.enabled = false;
        
        // 次の表示方式に切り替え
        displayType = (HintDisplayType)(((int)displayType + 1) % System.Enum.GetValues(typeof(HintDisplayType)).Length);
        
        SetupHintSystem();
        
        Debug.Log($"[NewHintManager] 表示方式を切り替えました: {displayType}");
        
        // 切り替え通知
        ShowSwitchNotification();
    }
    
    /// <summary>
    /// 切り替え通知を表示
    /// </summary>
    void ShowSwitchNotification()
    {
        string message = $"💡 ヒント表示方式\n{GetDisplayTypeName(displayType)}\nF9: 切り替え";
        
        // 通知システムがアクティブな場合はそれを使用
        if (notificationHint != null && notificationHint.enabled)
        {
            notificationHint.ShowCustomNotification(message);
        }
    }
    
    string GetDisplayTypeName(HintDisplayType type)
    {
        switch (type)
        {
            case HintDisplayType.Simple: return "パネル表示";
            case HintDisplayType.Minimal: return "最小限表示";
            case HintDisplayType.Notification: return "通知スタイル";
            default: return "不明";
        }
    }
    
    /// <summary>
    /// 外部からのヒント表示
    /// </summary>
    public void ShowHint()
    {
        switch (displayType)
        {
            case HintDisplayType.Simple:
                if (simpleHint != null) simpleHint.ShowRandomHint();
                break;
                
            case HintDisplayType.Minimal:
                if (minimalHint != null) minimalHint.ShowNextHint();
                break;
                
            case HintDisplayType.Notification:
                if (notificationHint != null) notificationHint.ShowCurrentHint();
                break;
        }
    }
    
    /// <summary>
    /// カスタムヒントを表示
    /// </summary>
    public void ShowCustomHint(string message)
    {
        switch (displayType)
        {
            case HintDisplayType.Simple:
                if (simpleHint != null) simpleHint.ShowSpecificHint(message);
                break;
                
            case HintDisplayType.Notification:
                if (notificationHint != null) notificationHint.ShowCustomNotification(message);
                break;
                
            default:
                Debug.Log($"[NewHintManager] カスタムヒント: {message}");
                break;
        }
    }
    
    /// <summary>
    /// 操作ヒントを表示
    /// </summary>
    public void ShowControlsHint()
    {
        string message = "💡 基本操作\nWASD: 移動\nマウス: 視点変更\nクリック: 選択・回答";
        ShowCustomHint(message);
    }
    
    /// <summary>
    /// 暗号ヒントを表示
    /// </summary>
    public void ShowCryptoHint()
    {
        switch (displayType)
        {
            case HintDisplayType.Simple:
                if (simpleHint != null) simpleHint.ShowCryptoHints();
                break;
                
            case HintDisplayType.Notification:
                if (notificationHint != null) notificationHint.ShowCryptoHint();
                break;
                
            default:
                ShowCustomHint("🔐 暗号の基本\n共通鍵・公開鍵・ハイブリッド");
                break;
        }
    }
    
    /// <summary>
    /// 表示タイプを取得
    /// </summary>
    public HintDisplayType GetCurrentDisplayType()
    {
        return displayType;
    }
    
    /// <summary>
    /// 表示タイプを設定
    /// </summary>
    public void SetDisplayType(HintDisplayType newType)
    {
        if (simpleHint != null) simpleHint.enabled = false;
        if (minimalHint != null) minimalHint.enabled = false;
        if (notificationHint != null) notificationHint.enabled = false;
        
        displayType = newType;
        SetupHintSystem();
        
        Debug.Log($"[NewHintManager] 表示タイプを変更しました: {displayType}");
    }
    
    /// <summary>
    /// 次の表示タイプに循環切り替え
    /// </summary>
    public void CycleDisplayType()
    {
        SwitchToNextDisplayType();
    }

    void OnGUI()
    {
        // 左下に統合ガイド
        GUIStyle style = new GUIStyle(GUI.skin.label);
        style.fontSize = 12;
        style.normal.textColor = Color.white;
        
        string guideText = $"💡 {hintKey}: ヒント ({GetDisplayTypeName(displayType)})\nF9: 表示方式切り替え\nF8: 古いシステム強制無効化";
        GUI.Label(new Rect(10, Screen.height - 80, 300, 70), guideText, style);
        
        // F8キーで強制無効化
        if (Input.GetKeyDown(KeyCode.F8))
        {
            ForceDisableOldSystems();
        }
    }
}
