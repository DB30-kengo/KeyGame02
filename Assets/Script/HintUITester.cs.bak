using UnityEngine;
using UnityEngine.UI;

/// <summary>
/// ヒントシーンのUI動作をリアルタイムでテストする
/// </summary>
public class HintUITester : MonoBehaviour
{
    [Header("Test Controls")]
    [Tooltip("自動テストを実行")]
    public bool runAutoTest = false;
    
    [Tooltip("テスト間隔（秒）")]
    public float testInterval = 2f;
    
    private GameHintManager hintManager;
    private float nextTestTime = 0f;
    private int testStep = 0;
    
    void Start()
    {
        hintManager = FindObjectOfType<GameHintManager>();
        if (hintManager == null)
        {
            Debug.LogError("[HintUITester] GameHintManager not found!");
        }
        
        // 手動テスト用UI作成
        CreateTestUI();
    }
    
    void Update()
    {
        if (runAutoTest && Time.time >= nextTestTime)
        {
            RunAutoTest();
            nextTestTime = Time.time + testInterval;
        }
        
        // キーボードショートカット
        if (Input.GetKeyDown(KeyCode.Alpha1))
        {
            TestCategorySelection(0);
        }
        if (Input.GetKeyDown(KeyCode.Alpha2))
        {
            TestCategorySelection(1);
        }
        if (Input.GetKeyDown(KeyCode.Alpha3))
        {
            TestCategorySelection(2);
        }
        if (Input.GetKeyDown(KeyCode.Escape))
        {
            TestBackNavigation();
        }
    }
    
    /// <summary>
    /// 自動テストを実行
    /// </summary>
    private void RunAutoTest()
    {
        if (hintManager == null) return;
        
        Debug.Log($"[HintUITester] Running auto test step: {testStep}");
        
        switch (testStep % 6)
        {
            case 0:
                Debug.Log("[HintUITester] Testing: Show Category Selection");
                hintManager.ShowCategorySelection();
                break;
            case 1:
                Debug.Log("[HintUITester] Testing: Select Symmetric Key Category");
                hintManager.SelectCategory(GameHintManager.HintCategory.SymmetricKey);
                break;
            case 2:
                Debug.Log("[HintUITester] Testing: Show First Hint");
                hintManager.ShowHint(0);
                break;
            case 3:
                Debug.Log("[HintUITester] Testing: Go Back to Selection");
                hintManager.GoBack();
                break;
            case 4:
                Debug.Log("[HintUITester] Testing: Go Back to Categories");
                hintManager.GoBack();
                break;
            case 5:
                Debug.Log("[HintUITester] Testing: Select Public Key Category");
                hintManager.SelectCategory(GameHintManager.HintCategory.PublicKey);
                break;
        }
        
        testStep++;
    }
    
    /// <summary>
    /// カテゴリ選択をテスト
    /// </summary>
    public void TestCategorySelection(int categoryIndex)
    {
        if (hintManager == null) return;
        
        GameHintManager.HintCategory category = (GameHintManager.HintCategory)(categoryIndex + 1);
        Debug.Log($"[HintUITester] Manual test: Selecting category {category}");
        hintManager.SelectCategory(category);
    }
    
    /// <summary>
    /// ヒント表示をテスト
    /// </summary>
    public void TestHintDisplay(int hintIndex)
    {
        if (hintManager == null) return;
        
        Debug.Log($"[HintUITester] Manual test: Showing hint {hintIndex}");
        hintManager.ShowHint(hintIndex);
    }
    
    /// <summary>
    /// 戻るナビゲーションをテスト
    /// </summary>
    public void TestBackNavigation()
    {
        if (hintManager == null) return;
        
        Debug.Log("[HintUITester] Manual test: Going back");
        hintManager.GoBack();
    }
    
    /// <summary>
    /// テスト用UIを作成
    /// </summary>
    private void CreateTestUI()
    {
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null) return;
        
        // テストパネル作成
        GameObject testPanel = new GameObject("TestPanel");
        testPanel.transform.SetParent(canvas.transform, false);
        
        RectTransform panelRect = testPanel.AddComponent<RectTransform>();
        panelRect.anchorMin = new Vector2(0.7f, 0.7f);
        panelRect.anchorMax = new Vector2(1f, 1f);
        panelRect.offsetMin = Vector2.zero;
        panelRect.offsetMax = Vector2.zero;
        
        Image panelImage = testPanel.AddComponent<Image>();
        panelImage.color = new Color(0, 0, 0, 0.8f);
        
        // テストボタン群
        string[] buttonTexts = { "共通鍵", "公開鍵", "ハイブリッド", "戻る", "自動テスト" };
        UnityEngine.Events.UnityAction[] buttonActions = {
            () => TestCategorySelection(0),
            () => TestCategorySelection(1),
            () => TestCategorySelection(2),
            () => TestBackNavigation(),
            () => { runAutoTest = !runAutoTest; Debug.Log($"Auto test: {runAutoTest}"); }
        };
        
        for (int i = 0; i < buttonTexts.Length; i++)
        {
            GameObject buttonObj = new GameObject($"TestButton_{i}");
            buttonObj.transform.SetParent(testPanel.transform, false);
            
            RectTransform buttonRect = buttonObj.AddComponent<RectTransform>();
            buttonRect.anchorMin = new Vector2(0.05f, 0.8f - i * 0.15f);
            buttonRect.anchorMax = new Vector2(0.95f, 0.9f - i * 0.15f);
            buttonRect.offsetMin = Vector2.zero;
            buttonRect.offsetMax = Vector2.zero;
            
            Image buttonImage = buttonObj.AddComponent<Image>();
            buttonImage.color = new Color(0.2f, 0.4f, 0.8f, 0.9f);
            
            Button button = buttonObj.AddComponent<Button>();
            button.onClick.AddListener(buttonActions[i]);
            
            // ボタンテキスト
            GameObject textObj = new GameObject("Text");
            textObj.transform.SetParent(buttonObj.transform, false);
            
            Text text = textObj.AddComponent<Text>();
            text.text = buttonTexts[i];
            text.font = UIUtility.GetDefaultFont();
            text.fontSize = 12;
            text.alignment = TextAnchor.MiddleCenter;
            text.color = Color.white;
            
            RectTransform textRect = textObj.GetComponent<RectTransform>();
            textRect.anchorMin = Vector2.zero;
            textRect.anchorMax = Vector2.one;
            textRect.offsetMin = Vector2.zero;
            textRect.offsetMax = Vector2.zero;
        }
        
        Debug.Log("[HintUITester] Test UI created. Use number keys 1-3 or test buttons to test functionality.");
    }
    
    /// <summary>
    /// 現在の状態をログ出力
    /// </summary>
    [ContextMenu("Log Current State")]
    public void LogCurrentState()
    {
        Debug.Log("[HintUITester] === CURRENT STATE ===");
        
        if (hintManager != null)
        {
            Debug.Log($"HintManager found: {hintManager.name}");
            
            // リフレクションで内部状態を取得
            var categoryField = typeof(GameHintManager).GetField("currentCategory", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (categoryField != null)
            {
                var currentCategory = categoryField.GetValue(hintManager);
                Debug.Log($"Current Category: {currentCategory}");
            }
        }
        else
        {
            Debug.LogWarning("HintManager not found!");
        }
        
        // アクティブなパネルを確認
        GameObject[] panels = { 
            GameObject.Find("CategoryPanel"),
            GameObject.Find("HintSelectionPanel"),
            GameObject.Find("HintDisplayPanel")
        };
        
        foreach (var panel in panels)
        {
            if (panel != null)
            {
                Debug.Log($"Panel {panel.name}: Active = {panel.activeSelf}");
            }
        }
    }
}
