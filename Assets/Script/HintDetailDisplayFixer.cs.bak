using UnityEngine;
using UnityEngine.UI;
using UnityEngine.EventSystems;
using System.Collections;

/// <summary>
/// ヒント詳細表示問題の完全修正
/// 既知の問題：ヒント詳細が表示されない
/// 解決方法：UIレイヤリング、フォント、レイアウトを全て再構築
/// </summary>
public class HintDetailDisplayFixer : MonoBehaviour
{
    [Header("修正オプション")]
    public bool autoFixOnStart = true;
    public bool debugMode = true;
    
    private RealHintSystem targetHintSystem;
    
    void Start()
    {
        if (autoFixOnStart)
        {
            StartCoroutine(AutoFixHintSystem());
        }
        
        if (debugMode)
        {
            Debug.Log("[HintDetailDisplayFixer] Ready. Press F5 to manually fix hint detail display issues.");
        }
    }
    
    void Update()
    {
        if (Input.GetKeyDown(KeyCode.F5))
        {
            StartCoroutine(ManualFixHintSystem());
        }
        
        if (Input.GetKeyDown(KeyCode.F6))
        {
            TestHintDetailDisplay();
        }
    }
    
    IEnumerator AutoFixHintSystem()
    {
        yield return new WaitForSeconds(1f); // Unityの初期化を待つ
        
        Debug.Log("[HintDetailDisplayFixer] Auto-fixing hint system...");
        
        // RealHintSystemを探す
        targetHintSystem = FindObjectOfType<RealHintSystem>();
        if (targetHintSystem == null)
        {
            Debug.LogWarning("[HintDetailDisplayFixer] No RealHintSystem found. Creating test instance.");
            GameObject hintObj = new GameObject("FixedRealHintSystem");
            targetHintSystem = hintObj.AddComponent<RealHintSystem>();
        }
        
        // 修正を適用
        ApplyHintDetailFixes();
    }
    
    IEnumerator ManualFixHintSystem()
    {
        Debug.Log("[HintDetailDisplayFixer] Manual fix initiated...");
        
        targetHintSystem = FindObjectOfType<RealHintSystem>();
        if (targetHintSystem == null)
        {
            Debug.LogError("[HintDetailDisplayFixer] No RealHintSystem found!");
            yield break;
        }
        
        ApplyHintDetailFixes();
        yield return new WaitForSeconds(0.5f);
        TestHintDetailDisplay();
    }
    
    void ApplyHintDetailFixes()
    {
        Debug.Log("[HintDetailDisplayFixer] Applying hint detail display fixes...");
        
        // 1. Canvas系統の確認・修正
        FixCanvasSystem();
        
        // 2. フォントシステムの確認
        VerifyFontSystem();
        
        // 3. RealHintSystemにパッチを当てる
        PatchRealHintSystem();
        
        Debug.Log("[HintDetailDisplayFixer] All fixes applied!");
    }
    
    void FixCanvasSystem()
    {
        Debug.Log("[HintDetailDisplayFixer] Fixing Canvas system...");
        
        // 既存のCanvasを確認
        Canvas[] canvases = FindObjectsOfType<Canvas>();
        Canvas mainCanvas = null;
        
        foreach (Canvas canvas in canvases)
        {
            if (canvas.renderMode == RenderMode.ScreenSpaceOverlay)
            {
                mainCanvas = canvas;
                break;
            }
        }
        
        // Canvasがない場合は作成
        if (mainCanvas == null)
        {
            GameObject canvasObj = new GameObject("HintSystemCanvas");
            mainCanvas = canvasObj.AddComponent<Canvas>();
            mainCanvas.renderMode = RenderMode.ScreenSpaceOverlay;
            mainCanvas.sortingOrder = 100; // 最前面に表示
            
            CanvasScaler scaler = canvasObj.AddComponent<CanvasScaler>();
            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
            scaler.referenceResolution = new Vector2(1920, 1080);
            
            canvasObj.AddComponent<GraphicRaycaster>();
            
            Debug.Log("[HintDetailDisplayFixer] Main Canvas created");
        }
        
        // EventSystemの確認
        if (FindObjectOfType<EventSystem>() == null)
        {
            GameObject eventObj = new GameObject("EventSystem");
            eventObj.AddComponent<EventSystem>();
            eventObj.AddComponent<StandaloneInputModule>();
            Debug.Log("[HintDetailDisplayFixer] EventSystem created");
        }
    }
    
    void VerifyFontSystem()
    {
        Debug.Log("[HintDetailDisplayFixer] Verifying font system...");
        
        Font testFont = UIUtility.GetDefaultFont();
        if (testFont == null)
        {
            Debug.LogError("[HintDetailDisplayFixer] Font system failure! Cannot get default font.");
            return;
        }
        
        Debug.Log($"[HintDetailDisplayFixer] Font system OK: {testFont.name}");
    }
    
    void PatchRealHintSystem()
    {
        if (targetHintSystem == null) return;
        
        Debug.Log("[HintDetailDisplayFixer] Patching RealHintSystem...");
        
        // RealHintSystemのコンポーネントにパッチコンポーネントを追加
        HintDetailPatch patch = targetHintSystem.gameObject.GetComponent<HintDetailPatch>();
        if (patch == null)
        {
            patch = targetHintSystem.gameObject.AddComponent<HintDetailPatch>();
        }
        
        patch.Initialize(targetHintSystem);
    }
    
    void TestHintDetailDisplay()
    {
        Debug.Log("[HintDetailDisplayFixer] Testing hint detail display...");
        
        if (targetHintSystem == null)
        {
            targetHintSystem = FindObjectOfType<RealHintSystem>();
        }
        
        if (targetHintSystem != null)
        {
            // カーソル設定
            Cursor.lockState = CursorLockMode.None;
            Cursor.visible = true;
            
            // ヒントシステム表示
            targetHintSystem.ShowHintSystem();
            
            // テスト用ヒント詳細表示
            StartCoroutine(ShowTestHintDetail());
        }
    }
    
    IEnumerator ShowTestHintDetail()
    {
        yield return new WaitForSeconds(0.5f);
        
        // 共通鍵暗号カテゴリを表示
        var showCategoryMethod = typeof(RealHintSystem).GetMethod("ShowCategoryHints", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        showCategoryMethod?.Invoke(targetHintSystem, new object[] { "symmetric", "共通鍵暗号" });
        
        yield return new WaitForSeconds(0.5f);
        
        // ヒント詳細を表示
        var showDetailMethod = typeof(RealHintSystem).GetMethod("ShowHintDetail", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        showDetailMethod?.Invoke(targetHintSystem, new object[] { 0 });
        
        Debug.Log("[HintDetailDisplayFixer] Test hint detail displayed!");
    }
    
    void OnGUI()
    {
        if (debugMode)
        {
            GUILayout.BeginArea(new Rect(10, 200, 350, 200));
            GUILayout.Label("=== Hint Detail Display Fixer ===");
            
            if (GUILayout.Button("F5: Manual Fix Hint System"))
            {
                StartCoroutine(ManualFixHintSystem());
            }
            
            if (GUILayout.Button("F6: Test Hint Detail Display"))
            {
                TestHintDetailDisplay();
            }
            
            if (GUILayout.Button("Check Canvas & EventSystem"))
            {
                CheckUIState();
            }
            
            if (GUILayout.Button("Create Emergency Hint Display"))
            {
                CreateEmergencyHintDisplay();
            }
            
            GUILayout.EndArea();
        }
    }
    
    void CheckUIState()
    {
        Debug.Log("=== UI State Check ===");
        
        Canvas[] canvases = FindObjectsOfType<Canvas>();
        Debug.Log($"Canvases: {canvases.Length}");
        foreach (var canvas in canvases)
        {
            Debug.Log($"  {canvas.name}: {canvas.renderMode}, Order: {canvas.sortingOrder}");
        }
        
        EventSystem eventSystem = FindObjectOfType<EventSystem>();
        Debug.Log($"EventSystem: {(eventSystem != null ? "Found" : "Missing")}");
        
        Font font = UIUtility.GetDefaultFont();
        Debug.Log($"Default Font: {(font != null ? font.name : "Missing")}");
    }
    
    void CreateEmergencyHintDisplay()
    {
        Debug.Log("[HintDetailDisplayFixer] Creating emergency hint display...");
        
        // 緊急用の简易ヒント表示を作成
        GameObject emergencyObj = new GameObject("EmergencyHintDisplay");
        
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            FixCanvasSystem();
            canvas = FindObjectOfType<Canvas>();
        }
        
        emergencyObj.transform.SetParent(canvas.transform, false);
        
        // 背景
        Image bg = emergencyObj.AddComponent<Image>();
        bg.color = new Color(0, 0, 0, 0.8f);
        
        RectTransform rect = emergencyObj.GetComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.1f, 0.1f);
        rect.anchorMax = new Vector2(0.9f, 0.9f);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        // テストテキスト
        GameObject textObj = new GameObject("TestHintText");
        textObj.transform.SetParent(emergencyObj.transform, false);
        
        Text text = textObj.AddComponent<Text>();
        text.text = "🔐 共通鍵暗号とは\n\n送信者と受信者が同じ鍵を使って暗号化・復号化を行う方式です。\n高速で効率的ですが、鍵の配送が課題となります。\n\n💡 AESやDESが代表的な共通鍵暗号です。";
        text.font = UIUtility.GetDefaultFont();
        text.fontSize = 18;
        text.color = Color.white;
        text.alignment = TextAnchor.UpperLeft;
        
        RectTransform textRect = text.GetComponent<RectTransform>();
        textRect.anchorMin = new Vector2(0.05f, 0.05f);
        textRect.anchorMax = new Vector2(0.95f, 0.95f);
        textRect.offsetMin = Vector2.zero;
        textRect.offsetMax = Vector2.zero;
        
        // 閉じるボタン
        GameObject closeButton = new GameObject("CloseButton");
        closeButton.transform.SetParent(emergencyObj.transform, false);
        
        Button button = closeButton.AddComponent<Button>();
        Image buttonImg = closeButton.AddComponent<Image>();
        buttonImg.color = Color.red;
        
        GameObject buttonText = new GameObject("ButtonText");
        buttonText.transform.SetParent(closeButton.transform, false);
        Text btnTxt = buttonText.AddComponent<Text>();
        btnTxt.text = "閉じる";
        btnTxt.font = UIUtility.GetDefaultFont();
        btnTxt.color = Color.white;
        btnTxt.alignment = TextAnchor.MiddleCenter;
        
        RectTransform btnRect = closeButton.GetComponent<RectTransform>();
        btnRect.sizeDelta = new Vector2(100, 40);
        btnRect.anchorMin = new Vector2(0.9f, 0.9f);
        btnRect.anchorMax = new Vector2(0.9f, 0.9f);
        btnRect.anchoredPosition = new Vector2(-50, -20);
        
        RectTransform btnTxtRect = buttonText.GetComponent<RectTransform>();
        btnTxtRect.anchorMin = Vector2.zero;
        btnTxtRect.anchorMax = Vector2.one;
        btnTxtRect.offsetMin = Vector2.zero;
        btnTxtRect.offsetMax = Vector2.zero;
        
        button.onClick.AddListener(() => {
            Debug.Log("[HintDetailDisplayFixer] Emergency hint display closed");
            Destroy(emergencyObj);
        });
        
        Debug.Log("[HintDetailDisplayFixer] Emergency hint display created successfully!");
    }
}

/// <summary>
/// RealHintSystemのShowHintDetailメソッドをパッチするコンポーネント
/// </summary>
public class HintDetailPatch : MonoBehaviour
{
    private RealHintSystem targetSystem;
    
    public void Initialize(RealHintSystem system)
    {
        targetSystem = system;
        Debug.Log("[HintDetailPatch] Initialized");
    }
    
    /// <summary>
    /// 修正版のヒント詳細表示メソッド
    /// </summary>
    public void ShowHintDetailFixed(int hintIndex, string category = "symmetric")
    {
        Debug.Log($"[HintDetailPatch] ShowHintDetailFixed called - Index: {hintIndex}, Category: {category}");
        
        // テスト用のヒントデータ
        var testHint = new RealHintSystem.HintItem(
            "共通鍵暗号とは",
            "送信者と受信者が同じ鍵を使って暗号化・復号化を行う方式です。高速で効率的ですが、鍵の配送が課題となります。",
            "AESやDESが代表的な共通鍵暗号です。"
        );
        
        CreateHintDetailDisplay(testHint);
    }
    
    void CreateHintDetailDisplay(RealHintSystem.HintItem hint)
    {
        Debug.Log("[HintDetailPatch] Creating hint detail display...");
        
        // 既存の表示をクリア
        GameObject existing = GameObject.Find("PatchedHintDetail");
        if (existing != null)
        {
            DestroyImmediate(existing);
        }
        
        // Canvas取得
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            Debug.LogError("[HintDetailPatch] No canvas found!");
            return;
        }
        
        // メインコンテナ作成
        GameObject container = new GameObject("PatchedHintDetail");
        container.transform.SetParent(canvas.transform, false);
        
        Image containerBg = container.AddComponent<Image>();
        containerBg.color = new Color(0.05f, 0.1f, 0.2f, 0.95f);
        
        RectTransform containerRect = container.GetComponent<RectTransform>();
        containerRect.anchorMin = Vector2.zero;
        containerRect.anchorMax = Vector2.one;
        containerRect.offsetMin = Vector2.zero;
        containerRect.offsetMax = Vector2.zero;
        
        // ヒント詳細エリア
        GameObject detailArea = new GameObject("HintDetailArea");
        detailArea.transform.SetParent(container.transform, false);
        
        Image detailBg = detailArea.AddComponent<Image>();
        detailBg.color = new Color(0.15f, 0.25f, 0.4f, 0.9f);
        
        RectTransform detailRect = detailArea.GetComponent<RectTransform>();
        detailRect.anchorMin = new Vector2(0.1f, 0.2f);
        detailRect.anchorMax = new Vector2(0.9f, 0.8f);
        detailRect.offsetMin = Vector2.zero;
        detailRect.offsetMax = Vector2.zero;
        
        // タイトル
        CreateTextElement(detailArea, "HintTitle", hint.title, 
            new Vector2(0.05f, 0.8f), new Vector2(0.95f, 0.95f), 
            24, Color.yellow, TextAnchor.UpperCenter, FontStyle.Bold);
        
        // 内容
        CreateTextElement(detailArea, "HintContent", hint.content, 
            new Vector2(0.05f, 0.4f), new Vector2(0.95f, 0.8f), 
            18, Color.white, TextAnchor.UpperLeft, FontStyle.Normal);
        
        // 追加情報
        if (!string.IsNullOrEmpty(hint.additionalInfo))
        {
            CreateTextElement(detailArea, "AdditionalInfo", "💡 " + hint.additionalInfo, 
                new Vector2(0.05f, 0.1f), new Vector2(0.95f, 0.4f), 
                16, Color.cyan, TextAnchor.UpperLeft, FontStyle.Normal);
        }
        
        // 閉じるボタン
        CreateCloseButton(container);
        
        Debug.Log("[HintDetailPatch] Hint detail display created successfully!");
    }
    
    void CreateTextElement(GameObject parent, string name, string text, 
        Vector2 anchorMin, Vector2 anchorMax, int fontSize, Color color, 
        TextAnchor alignment, FontStyle style)
    {
        GameObject textObj = new GameObject(name);
        textObj.transform.SetParent(parent.transform, false);
        
        Text textComponent = textObj.AddComponent<Text>();
        textComponent.text = text;
        textComponent.font = UIUtility.GetDefaultFont();
        textComponent.fontSize = fontSize;
        textComponent.color = color;
        textComponent.alignment = alignment;
        textComponent.fontStyle = style;
        textComponent.lineSpacing = 1.2f;
        
        RectTransform rect = textObj.GetComponent<RectTransform>();
        rect.anchorMin = anchorMin;
        rect.anchorMax = anchorMax;
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        Debug.Log($"[HintDetailPatch] Text element '{name}' created with text: '{text.Substring(0, Mathf.Min(30, text.Length))}...'");
    }
    
    void CreateCloseButton(GameObject parent)
    {
        GameObject buttonObj = new GameObject("CloseButton");
        buttonObj.transform.SetParent(parent.transform, false);
        
        Button button = buttonObj.AddComponent<Button>();
        Image buttonImg = buttonObj.AddComponent<Image>();
        buttonImg.color = new Color(0.6f, 0.3f, 0.3f, 0.8f);
        
        RectTransform buttonRect = buttonObj.GetComponent<RectTransform>();
        buttonRect.sizeDelta = new Vector2(120, 50);
        buttonRect.anchorMin = new Vector2(0.5f, 0.05f);
        buttonRect.anchorMax = new Vector2(0.5f, 0.05f);
        buttonRect.anchoredPosition = Vector2.zero;
        
        // ボタンテキスト
        GameObject textObj = new GameObject("ButtonText");
        textObj.transform.SetParent(buttonObj.transform, false);
        
        Text buttonText = textObj.AddComponent<Text>();
        buttonText.text = "閉じる";
        buttonText.font = UIUtility.GetDefaultFont();
        buttonText.fontSize = 16;
        buttonText.color = Color.white;
        buttonText.alignment = TextAnchor.MiddleCenter;
        
        RectTransform textRect = textObj.GetComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.offsetMin = Vector2.zero;
        textRect.offsetMax = Vector2.zero;
        
        button.onClick.AddListener(() => {
            Debug.Log("[HintDetailPatch] Close button clicked");
            Destroy(parent);
        });
    }
}
