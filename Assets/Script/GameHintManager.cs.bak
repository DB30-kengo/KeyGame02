    /// <summary>
    /// ボタンのイベント設定
    /// </summary>
    private void SetupButtons()
    {
        Debug.Log("[GameHintManager] Setting up button events...");
        
        // UI要素の自動検索・設定
        AutoDetectUIElements();
        
        // カテゴリボタンの設定
        if (categoryButtons != null && categoryButtons.Length >= 5)
        {
            for (int i = 0; i < 5; i++)
            {
                if (categoryButtons[i] != null)
                {
                    int categoryIndex = i; // クロージャ対応
                    categoryButtons[i].onClick.RemoveAllListeners();
                    categoryButtons[i].onClick.AddListener(() => {
                        Debug.Log($"[GameHintManager] Category button {categoryIndex} clicked");
                        SelectCategory((HintCategory)(categoryIndex + 1));
                    });
                    Debug.Log($"[GameHintManager] Category button {i} event set");
                }
                else
                {
                    Debug.LogWarning($"[GameHintManager] Category button {i} is null");
                }
            }
        }
        else
        {
            Debug.LogWarning("[GameHintManager] Category buttons array is null or insufficient length");
        }
        
        // ヒント選択ボタンの設定
        if (hintSelectionButtons != null)
        {
            for (int i = 0; i < hintSelectionButtons.Length; i++)
            {
                if (hintSelectionButtons[i] != null)
                {
                    int index = i; // クロージャ対応
                    hintSelectionButtons[i].onClick.RemoveAllListeners();
                    hintSelectionButtons[i].onClick.AddListener(() => {
                        Debug.Log($"[GameHintManager] Hint selection button {index} clicked");
                        ShowHint(index);
                    });
                    Debug.Log($"[GameHintManager] Hint selection button {i} event set");
                }
                else
                {
                    Debug.LogWarning($"[GameHintManager] Hint selection button {i} is null");
                }
            }
        }
        
        // 戻るボタン
        if (backButton != null)
        {
            backButton.onClick.RemoveAllListeners();
            backButton.onClick.AddListener(() => {
                Debug.Log("[GameHintManager] Back button clicked");
                GoBack();
            });
            Debug.Log("[GameHintManager] Back button event set");
        }
        else
        {
            Debug.LogWarning("[GameHintManager] Back button is null");
        }
        
        // メインメニューボタン
        if (mainMenuButton != null)
        {
            mainMenuButton.onClick.RemoveAllListeners();
            mainMenuButton.onClick.AddListener(() => {
                Debug.Log("[GameHintManager] Main menu button clicked");
                GoToMainMenu();
            });
            Debug.Log("[GameHintManager] Main menu button event set");
        }
        else
        {
            Debug.LogWarning("[GameHintManager] Main menu button is null");
        }
        
        Debug.Log("[GameHintManager] Button setup completed");
    }
    
    /// <summary>
    /// UI要素の自動検出
    /// </summary>
    private void AutoDetectUIElements()
    {
        Debug.Log("[GameHintManager] Auto-detecting UI elements...");
        
        // Canvas検索
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            Debug.LogError("[GameHintManager] Canvas not found!");
            return;
        }
        
        // ヒント内容テキストの自動検出
        if (hintContentText == null)
        {
            hintContentText = FindUIElementByName<Text>("HintContent", "ヒント内容", "Content");
            if (hintContentText != null)
                Debug.Log("[GameHintManager] Auto-detected hint content text");
        }
        
        // ヒントタイトルテキストの自動検出
        if (hintTitleText == null)
        {
            hintTitleText = FindUIElementByName<Text>("HintTitle", "ヒントタイトル", "Title");
            if (hintTitleText != null)
                Debug.Log("[GameHintManager] Auto-detected hint title text");
        }
        
        // カテゴリボタンの自動検出
        if (categoryButtons == null || categoryButtons.Length < 5)
        {
            categoryButtons = new Button[5];
            string[] categoryNames = { "共通鍵", "公開鍵", "ハイブリッド", "ゲーム操作", "一般" };
            
            for (int i = 0; i < 5; i++)
            {
                categoryButtons[i] = FindUIElementByName<Button>(
                    $"Button_{categoryNames[i]}", 
                    categoryNames[i],
                    $"Category{i}",
                    $"CategoryButton{i}"
                );
                
                if (categoryButtons[i] != null)
                    Debug.Log($"[GameHintManager] Auto-detected category button {i}: {categoryNames[i]}");
            }
        }
        
        // ヒント選択ボタンの自動検出
        if (hintSelectionButtons == null || hintSelectionButtons.Length < 6)
        {
            hintSelectionButtons = new Button[6];
            
            for (int i = 0; i < 6; i++)
            {
                hintSelectionButtons[i] = FindUIElementByName<Button>(
                    $"Button_ヒント{i + 1}",
                    $"ヒント{i + 1}",
                    $"Hint{i}",
                    $"HintButton{i}"
                );
                
                if (hintSelectionButtons[i] != null)
                    Debug.Log($"[GameHintManager] Auto-detected hint selection button {i}");
            }
        }
        
        // 戻るボタンの自動検出
        if (backButton == null)
        {
            backButton = FindUIElementByName<Button>("戻る", "Back", "← 戻る", "Button_戻る");
            if (backButton != null)
                Debug.Log("[GameHintManager] Auto-detected back button");
        }
        
        // メインメニューボタンの自動検出
        if (mainMenuButton == null)
        {
            mainMenuButton = FindUIElementByName<Button>("メインメニュー", "MainMenu", "Button_メインメニュー");
            if (mainMenuButton != null)
                Debug.Log("[GameHintManager] Auto-detected main menu button");
        }
        
        // パネルの自動検出
        if (categoryPanel == null)
        {
            categoryPanel = FindGameObjectByName("CategoryPanel", "カテゴリパネル", "Category");
            if (categoryPanel != null)
                Debug.Log("[GameHintManager] Auto-detected category panel");
        }
        
        if (hintSelectionPanel == null)
        {
            hintSelectionPanel = FindGameObjectByName("HintSelectionPanel", "ヒント選択パネル", "Selection");
            if (hintSelectionPanel != null)
                Debug.Log("[GameHintManager] Auto-detected hint selection panel");
        }
        
        if (hintDisplayPanel == null)
        {
            hintDisplayPanel = FindGameObjectByName("HintDisplayPanel", "ヒント表示パネル", "Display");
            if (hintDisplayPanel != null)
                Debug.Log("[GameHintManager] Auto-detected hint display panel");
        }
        
        Debug.Log("[GameHintManager] Auto-detection completed");
    }
    
    /// <summary>
    /// 複数の名前候補でUI要素を検索
    /// </summary>
    private T FindUIElementByName<T>(params string[] names) where T : Component
    {
        foreach (string name in names)
        {
            GameObject obj = GameObject.Find(name);
            if (obj != null)
            {
                T component = obj.GetComponent<T>();
                if (component != null)
                {
                    return component;
                }
            }
        }
        
        // 名前に含まれる検索も試行
        T[] allComponents = FindObjectsOfType<T>();
        foreach (T component in allComponents)
        {
            foreach (string name in names)
            {
                if (component.name.Contains(name))
                {
                    return component;
                }
            }
        }
        
        return null;
    }
    
    /// <summary>
    /// 複数の名前候補でGameObjectを検索
    /// </summary>
    private GameObject FindGameObjectByName(params string[] names)
    {
        foreach (string name in names)
        {
            GameObject obj = GameObject.Find(name);
            if (obj != null)
            {
                return obj;
            }
        }
        
        // 名前に含まれる検索も試行
        GameObject[] allObjects = FindObjectsOfType<GameObject>();
        foreach (GameObject obj in allObjects)
        {
            foreach (string name in names)
            {
                if (obj.name.Contains(name))
                {
                    return obj;
                }
            }
        }
        
        return null;
    }
    
    /// <summary>
    /// カテゴリ選択画面を表示
    /// </summary>
    public void ShowCategorySelection()
    {
        currentCategory = HintCategory.None;
        
        if (categoryPanel != null) categoryPanel.SetActive(true);
        if (hintSelectionPanel != null) hintSelectionPanel.SetActive(false);
        if (hintDisplayPanel != null) hintDisplayPanel.SetActive(false);
        
        // カテゴリボタンのテキスト設定
        if (categoryButtons.Length >= 5)
        {
            SetButtonText(categoryButtons[0], "共通鍵暗号");
            SetButtonText(categoryButtons[1], "公開鍵暗号");
            SetButtonText(categoryButtons[2], "ハイブリッド暗号");
            SetButtonText(categoryButtons[3], "ゲーム操作");
            SetButtonText(categoryButtons[4], "一般的なヒント");
        }
    }
    
    /// <summary>
    /// カテゴリを選択
    /// </summary>
    public void SelectCategory(HintCategory category)
    {
        Debug.Log($"[GameHintManager] SelectCategory called with: {category}");
        currentCategory = category;
        ShowHintSelection();
    }
    
    /// <summary>
    /// ヒント選択画面を表示
    /// </summary>
    private void ShowHintSelection()
    {
        Debug.Log($"[GameHintManager] ShowHintSelection called for category: {currentCategory}");
        
        if (categoryPanel != null) 
        {
            categoryPanel.SetActive(false);
            Debug.Log("[GameHintManager] Category panel hidden");
        }
        else
        {
            Debug.LogWarning("[GameHintManager] Category panel is null");
        }
        
        if (hintSelectionPanel != null) 
        {
            hintSelectionPanel.SetActive(true);
            Debug.Log("[GameHintManager] Hint selection panel shown");
        }
        else
        {
            Debug.LogWarning("[GameHintManager] Hint selection panel is null");
        }
        
        if (hintDisplayPanel != null) 
        {
            hintDisplayPanel.SetActive(false);
            Debug.Log("[GameHintManager] Hint display panel hidden");
        }
        else
        {
            Debug.LogWarning("[GameHintManager] Hint display panel is null");
        }
        
        // 選択されたカテゴリのヒント一覧を表示
        if (hintDatabase != null && hintDatabase.ContainsKey(currentCategory))
        {
            List<HintData> hints = hintDatabase[currentCategory];
            Debug.Log($"[GameHintManager] Found {hints.Count} hints for category {currentCategory}");
            
            if (hintSelectionButtons != null)
            {
                for (int i = 0; i < hintSelectionButtons.Length; i++)
                {
                    if (hintSelectionButtons[i] != null)
                    {
                        if (i < hints.Count)
                        {
                            hintSelectionButtons[i].gameObject.SetActive(true);
                            SetButtonText(hintSelectionButtons[i], hints[i].title);
                            Debug.Log($"[GameHintManager] Set hint button {i}: {hints[i].title}");
                        }
                        else
                        {
                            hintSelectionButtons[i].gameObject.SetActive(false);
                        }
                    }
                    else
                    {
                        Debug.LogWarning($"[GameHintManager] Hint selection button {i} is null");
                    }
                }
            }
            else
            {
                Debug.LogWarning("[GameHintManager] Hint selection buttons array is null");
            }
        }
        else
        {
            Debug.LogWarning($"[GameHintManager] No hints found for category: {currentCategory}");
        }
    }
    
    /// <summary>
    /// 指定されたヒントを表示
    /// </summary>
    public void ShowHint(int hintIndex)
    {
        Debug.Log($"[GameHintManager] ShowHint called with index: {hintIndex}, category: {currentCategory}");
        
        if (hintDatabase == null || !hintDatabase.ContainsKey(currentCategory))
        {
            Debug.LogWarning($"[GameHintManager] No hints found for category: {currentCategory}");
            return;
        }
        
        List<HintData> hints = hintDatabase[currentCategory];
        if (hintIndex >= hints.Count)
        {
            Debug.LogWarning($"[GameHintManager] Hint index {hintIndex} out of range (max: {hints.Count - 1})");
            return;
        }
        
        currentHintIndex = hintIndex;
        HintData hint = hints[hintIndex];
        
        Debug.Log($"[GameHintManager] Displaying hint: {hint.title}");
        
        if (categoryPanel != null) 
        {
            categoryPanel.SetActive(false);
            Debug.Log("[GameHintManager] Category panel hidden");
        }
        
        if (hintSelectionPanel != null) 
        {
            hintSelectionPanel.SetActive(false);
            Debug.Log("[GameHintManager] Hint selection panel hidden");
        }
        
        if (hintDisplayPanel != null) 
        {
            hintDisplayPanel.SetActive(true);
            Debug.Log("[GameHintManager] Hint display panel shown");
        }
        else
        {
            Debug.LogWarning("[GameHintManager] Hint display panel is null");
        }
        
        if (hintTitleText != null) 
        {
            hintTitleText.text = hint.title;
            Debug.Log($"[GameHintManager] Set hint title: {hint.title}");
        }
        else
        {
            Debug.LogWarning("[GameHintManager] Hint title text is null");
        }
        
        if (hintContentText != null) 
        {
            hintContentText.text = hint.content;
            Debug.Log($"[GameHintManager] Set hint content: {hint.content.Substring(0, Mathf.Min(50, hint.content.Length))}...");
        }
        else
        {
            Debug.LogWarning("[GameHintManager] Hint content text is null");
        }
    }
    
    /// <summary>
    /// 戻る処理
    /// </summary>
    public void GoBack()
    {
        if (hintDisplayPanel != null && hintDisplayPanel.activeSelf)
        {
            // ヒント表示→ヒント選択
            ShowHintSelection();
        }
        else if (hintSelectionPanel != null && hintSelectionPanel.activeSelf)
        {
            // ヒント選択→カテゴリ選択
            ShowCategorySelection();
        }
        else
        {
            // カテゴリ選択→元のシーンに戻る
            ReturnToPreviousScene();
        }
    }
    
    /// <summary>
    /// メインメニューに戻る
    /// </summary>
    public void GoToMainMenu()
    {
        // メインメニューシーンがあれば戻る、なければ元のシーンに戻る
        string mainMenuScene = "MainMenu";
        if (Application.CanStreamedLevelBeLoaded(mainMenuScene))
        {
            SceneManager.LoadScene(mainMenuScene);
        }
        else
        {
            ReturnToPreviousScene();
        }
    }
    
    /// <summary>
    /// ボタンのテキストを設定
    /// </summary>
    private void SetButtonText(Button button, string text)
    {
        if (button != null)
        {
            Text buttonText = button.GetComponentInChildren<Text>();
            if (buttonText != null)
            {
                buttonText.text = text;
            }
        }
    }
    
    /// <summary>
    /// 外部からカテゴリを設定（他シーンからの呼び出し用）
    /// </summary>
    public void SetCategoryFromExternal(int categoryIndex)
    {
        HintCategory category = (HintCategory)(categoryIndex + 1);
        SelectCategory(category);
    }
    
    /// <summary>
    /// 元のシーンに戻る
    /// </summary>
    private void ReturnToPreviousScene()
    {
        string returnScene = PlayerPrefs.GetString("ReturnScene", "SampleScene");
        
        Debug.Log($"[GameHintManager] Returning to scene: {returnScene}");
        
        try
        {
            // カーソル状態を復元
            HintSceneTransition.RestoreCursorState();
            
            // PlayerPrefsをクリア
            PlayerPrefs.DeleteKey("HintCategory");
            PlayerPrefs.Save();
            
            if (Application.CanStreamedLevelBeLoaded(returnScene))
            {
                SceneManager.LoadScene(returnScene);
            }
            else
            {
                Debug.LogWarning($"[GameHintManager] Cannot return to '{returnScene}', loading first scene in build settings.");
                SceneManager.LoadScene(0);
            }
        }
        catch (System.Exception e)
        {
            Debug.LogError($"[GameHintManager] Error returning to previous scene: {e.Message}");
            SceneManager.LoadScene(0);
        }
    }
    
    /// <summary>
    /// ヒントシーン用にカーソルを設定
    /// </summary>
    private void SetCursorForHintScene()
    {
        Cursor.lockState = CursorLockMode.None;
        Cursor.visible = true;
        Debug.Log("[GameHintManager] Cursor set for hint scene - LockState: None, Visible: true");
    }
}
