using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;
using System.Collections;

/// <summary>
/// ヒントシステムの問題を特定し、修正するための包括的テストツール
/// </summary>
public class HintSystemFixer : MonoBehaviour
{
    [Header("Fix Settings")]
    [Tooltip("自動修正を実行するか")]
    public bool autoFix = true;
    
    [Tooltip("詳細ログ表示")]
    public bool showDetailedLogs = true;
    
    [Header("Test UI")]
    public Text statusText;
    public Button fixButton;
    
    private RealHintSystem targetSystem;
    
    void Start()
    {
        CreateFixUI();
        
        if (autoFix)
        {
            StartCoroutine(RunCompleteFix());
        }
    }
    
    void Update()
    {
        // 緊急修正キー
        if (Input.GetKeyDown(KeyCode.LeftShift) && Input.GetKeyDown(KeyCode.F))
        {
            StartCoroutine(RunCompleteFix());
        }
    }
    
    /// <summary>
    /// 修正UIを作成
    /// </summary>
    private void CreateFixUI()
    {
        // Canvas確保
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            GameObject canvasObj = new GameObject("FixerCanvas");
            canvas = canvasObj.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvas.sortingOrder = 500;
            canvasObj.AddComponent<CanvasScaler>();
            canvasObj.AddComponent<GraphicRaycaster>();
        }
        
        // ステータステキスト
        if (statusText == null)
        {
            GameObject statusObj = new GameObject("FixerStatus");
            statusObj.transform.SetParent(canvas.transform, false);
            
            RectTransform statusRect = statusObj.AddComponent<RectTransform>();
            statusRect.anchorMin = new Vector2(0.02f, 0.8f);
            statusRect.anchorMax = new Vector2(0.5f, 0.98f);
            statusRect.offsetMin = Vector2.zero;
            statusRect.offsetMax = Vector2.zero;
            
            // 背景
            Image statusBg = statusObj.AddComponent<Image>();
            statusBg.color = new Color(0.1f, 0.1f, 0.1f, 0.8f);
            
            statusText = statusObj.AddComponent<Text>();
            statusText.font = UIUtility.GetDefaultFont();
            statusText.fontSize = 12;
            statusText.color = Color.yellow;
            statusText.alignment = TextAnchor.UpperLeft;
            statusText.text = "Hint System Fixer\nShift+F: Emergency Fix";
        }
        
        // 修正ボタン
        if (fixButton == null)
        {
            GameObject buttonObj = new GameObject("FixButton");
            buttonObj.transform.SetParent(canvas.transform, false);
            
            RectTransform buttonRect = buttonObj.AddComponent<RectTransform>();
            buttonRect.anchorMin = new Vector2(0.02f, 0.7f);
            buttonRect.anchorMax = new Vector2(0.25f, 0.78f);
            buttonRect.offsetMin = Vector2.zero;
            buttonRect.offsetMax = Vector2.zero;
            
            fixButton = buttonObj.AddComponent<Button>();
            Image buttonImage = buttonObj.AddComponent<Image>();
            buttonImage.color = new Color(0.8f, 0.6f, 0.2f, 0.8f);
            
            // ボタンテキスト
            GameObject textObj = new GameObject("Text");
            textObj.transform.SetParent(buttonObj.transform, false);
            
            Text buttonText = textObj.AddComponent<Text>();
            buttonText.text = "🔧 Complete Fix";
            buttonText.font = UIUtility.GetDefaultFont();
            buttonText.fontSize = 14;
            buttonText.color = Color.white;
            buttonText.alignment = TextAnchor.MiddleCenter;
            
            RectTransform textRect = textObj.GetComponent<RectTransform>();
            textRect.anchorMin = Vector2.zero;
            textRect.anchorMax = Vector2.one;
            textRect.offsetMin = Vector2.zero;
            textRect.offsetMax = Vector2.zero;
            
            // ボタンイベント
            fixButton.onClick.AddListener(() => StartCoroutine(RunCompleteFix()));
        }
    }
    
    /// <summary>
    /// 完全修正を実行
    /// </summary>
    private IEnumerator RunCompleteFix()
    {
        UpdateStatus("🔧 ヒントシステム完全修正開始...");
        yield return new WaitForSeconds(0.5f);
        
        // Step 1: 基本システム確認・修正
        UpdateStatus("Step 1: 基本システム確認・修正");
        FixBasicSystems();
        yield return new WaitForSeconds(1f);
        
        // Step 2: RealHintSystem修正
        UpdateStatus("Step 2: RealHintSystem修正");
        FixRealHintSystem();
        yield return new WaitForSeconds(1f);
        
        // Step 3: UI要素修正
        UpdateStatus("Step 3: UI要素修正");
        FixUIElements();
        yield return new WaitForSeconds(1f);
        
        // Step 4: ナビゲーション修正
        UpdateStatus("Step 4: ナビゲーション修正");
        FixNavigation();
        yield return new WaitForSeconds(1f);
        
        // Step 5: 最終テスト
        UpdateStatus("Step 5: 最終動作テスト");
        yield return StartCoroutine(RunFinalTest());
        
        UpdateStatus("✅ ヒントシステム修正完了！");
    }
    
    /// <summary>
    /// 基本システムを修正
    /// </summary>
    private void FixBasicSystems()
    {
        // Canvas確認・作成
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            GameObject canvasObj = new GameObject("MainCanvas");
            canvas = canvasObj.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvasObj.AddComponent<CanvasScaler>();
            canvasObj.AddComponent<GraphicRaycaster>();
            Log("✓ Canvas作成");
        }
        
        // EventSystem確認・作成
        UnityEngine.EventSystems.EventSystem eventSystem = FindObjectOfType<UnityEngine.EventSystems.EventSystem>();
        if (eventSystem == null)
        {
            GameObject eventObj = new GameObject("EventSystem");
            eventObj.AddComponent<UnityEngine.EventSystems.EventSystem>();
            eventObj.AddComponent<UnityEngine.EventSystems.StandaloneInputModule>();
            Log("✓ EventSystem作成");
        }
        
        // カーソル設定
        Cursor.lockState = CursorLockMode.None;
        Cursor.visible = true;
        Log("✓ カーソル設定完了");
    }
    
    /// <summary>
    /// RealHintSystemを修正
    /// </summary>
    private void FixRealHintSystem()
    {
        targetSystem = FindObjectOfType<RealHintSystem>();
        
        if (targetSystem == null)
        {
            // RealHintSystemが存在しない場合は作成
            GameObject systemObj = new GameObject("RealHintSystem (Fixed)");
            targetSystem = systemObj.AddComponent<RealHintSystem>();
            targetSystem.returnSceneName = PlayerPrefs.GetString("PreviousScene", "Chapter_game");
            Log("✓ RealHintSystem作成");
        }
        else
        {
            // 既存システムの設定確認
            if (string.IsNullOrEmpty(targetSystem.returnSceneName))
            {
                targetSystem.returnSceneName = PlayerPrefs.GetString("PreviousScene", "Chapter_game");
            }
            
            // Canvasの確認
            if (targetSystem.mainCanvas == null)
            {
                targetSystem.mainCanvas = FindObjectOfType<Canvas>();
            }
            
            Log("✓ RealHintSystem設定確認");
        }
    }
    
    /// <summary>
    /// UI要素を修正
    /// </summary>
    private void FixUIElements()
    {
        if (targetSystem == null) return;
        
        // 必要に応じてUIを再構築
        try
        {
            // リフレクションでInitializeHintDatabaseを呼び出し
            var method = typeof(RealHintSystem).GetMethod("InitializeHintDatabase", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            
            if (method != null)
            {
                method.Invoke(targetSystem, null);
                Log("✓ ヒントデータベース初期化");
            }
        }
        catch (System.Exception e)
        {
            Log($"⚠️ データベース初期化エラー: {e.Message}");
        }
        
        // UIUtility確認
        try
        {
            Font testFont = UIUtility.GetDefaultFont();
            if (testFont != null)
            {
                Log("✓ UIUtility正常");
            }
            else
            {
                Log("⚠️ UIUtility警告");
            }
        }
        catch (System.Exception e)
        {
            Log($"❌ UIUtilityエラー: {e.Message}");
        }
    }
    
    /// <summary>
    /// ナビゲーションを修正
    /// </summary>
    private void FixNavigation()
    {
        if (targetSystem == null) return;
        
        // ReturnToMainGame関数のテスト
        try
        {
            // シーン遷移の準備確認
            string returnScene = targetSystem.returnSceneName;
            
            int sceneIndex = SceneUtility.GetBuildIndexByScenePath($"Assets/Scenes/{returnScene}.unity");
            if (sceneIndex == -1)
            {
                // Build Settingsにシーンがない場合の警告
                Log($"⚠️ シーン '{returnScene}' がBuild Settingsに登録されていません");
                
                // デフォルトシーンに設定
                targetSystem.returnSceneName = "Chapter_game";
                Log("→ デフォルトシーンに設定しました");
            }
            else
            {
                Log($"✓ 戻り先シーン確認: {returnScene}");
            }
        }
        catch (System.Exception e)
        {
            Log($"⚠️ ナビゲーション確認エラー: {e.Message}");
        }
    }
    
    /// <summary>
    /// 最終テストを実行
    /// </summary>
    private IEnumerator RunFinalTest()
    {
        if (targetSystem == null)
        {
            UpdateStatus("❌ 最終テスト失敗: システムなし");
            yield break;
        }
        
        UpdateStatus("カテゴリ表示テスト...");
        yield return new WaitForSeconds(1f);
        
        // カテゴリインターフェースの確認
        try
        {
            var method = typeof(RealHintSystem).GetMethod("CreateCategoryInterface", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            
            if (method != null)
            {
                method.Invoke(targetSystem, null);
                Log("✓ カテゴリ表示テスト成功");
                UpdateStatus("✓ カテゴリ表示テスト成功");
            }
        }
        catch (System.Exception e)
        {
            Log($"❌ カテゴリ表示テスト失敗: {e.Message}");
            UpdateStatus($"❌ カテゴリ表示テスト失敗");
        }
        
        yield return new WaitForSeconds(1f);
        
        UpdateStatus("ナビゲーションテスト...");
        
        // ナビゲーションボタンの確認
        Button[] buttons = FindObjectsOfType<Button>();
        int navigationButtons = 0;
        
        foreach (Button button in buttons)
        {
            if (button.name.Contains("NavButton") || button.name.Contains("CategoryButton"))
            {
                navigationButtons++;
            }
        }
        
        Log($"✓ ナビゲーションボタン数: {navigationButtons}");
        UpdateStatus($"✓ ナビゲーションボタン: {navigationButtons}個");
        
        yield return new WaitForSeconds(1f);
    }
    
    /// <summary>
    /// 緊急シーン修正
    /// </summary>
    [ContextMenu("Emergency Scene Fix")]
    public void EmergencySceneFix()
    {
        Log("🚨 緊急シーン修正実行");
        
        // すべてのRealHintSystemを削除
        RealHintSystem[] existingSystems = FindObjectsOfType<RealHintSystem>();
        foreach (var system in existingSystems)
        {
            DestroyImmediate(system.gameObject);
        }
        
        // 新しいシステムを作成
        FixBasicSystems();
        FixRealHintSystem();
        
        Log("🚨 緊急修正完了");
        UpdateStatus("🚨 緊急修正完了 - システムリセット");
    }
    
    /// <summary>
    /// 手動でヒント詳細をテスト
    /// </summary>
    [ContextMenu("Test Hint Detail")]
    public void TestHintDetail()
    {
        if (targetSystem == null)
        {
            targetSystem = FindObjectOfType<RealHintSystem>();
        }
        
        if (targetSystem == null)
        {
            Log("❌ RealHintSystemが見つかりません");
            return;
        }
        
        // リフレクションでShowHintDetailを呼び出し
        try
        {
            var method = typeof(RealHintSystem).GetMethod("ShowHintDetail", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            
            if (method != null)
            {
                // currentCategoryを設定
                var categoryField = typeof(RealHintSystem).GetField("currentCategory", 
                    System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
                
                if (categoryField != null)
                {
                    categoryField.SetValue(targetSystem, "symmetric");
                }
                
                method.Invoke(targetSystem, new object[] { 0 });
                Log("✓ ヒント詳細テスト実行");
            }
        }
        catch (System.Exception e)
        {
            Log($"❌ ヒント詳細テストエラー: {e.Message}");
        }
    }
    
    private void UpdateStatus(string message)
    {
        if (statusText != null)
        {
            statusText.text = $"Hint System Fixer\nShift+F: Emergency Fix\n\n{message}";
        }
        Log(message);
    }
    
    private void Log(string message)
    {
        if (showDetailedLogs)
        {
            Debug.Log($"[HintSystemFixer] {message}");
        }
    }
}
