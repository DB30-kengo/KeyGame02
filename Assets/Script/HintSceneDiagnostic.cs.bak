using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;

/// <summary>
/// ヒントシーンのボタン動作問題を診断・修正するツール
/// </summary>
public class HintSceneDiagnostic : MonoBehaviour
{
    [Header("Diagnostic Results")]
    [SerializeField] private bool canvasExists = false;
    [SerializeField] private bool eventSystemExists = false;
    [SerializeField] private bool gameHintManagerExists = false;
    [SerializeField] private bool buttonsExist = false;
    [SerializeField] private bool buttonsHaveListeners = false;
    
    [Header("Manual Fix Options")]
    [Tooltip("完全な修復を実行")]
    public bool performCompleteFix = true;
    
    void Start()
    {
        // 自動診断を実行
        StartCoroutine(DiagnoseAndFix());
    }
    
    /// <summary>
    /// ヒントシーンの診断と修復を実行
    /// </summary>
    [ContextMenu("Diagnose and Fix Hint Scene")]
    public System.Collections.IEnumerator DiagnoseAndFix()
    {
        Debug.Log("=== ヒントシーン診断開始 ===");
        
        yield return new WaitForEndOfFrame();
        
        // 1. 基本的なUI要素の確認
        DiagnoseBasicElements();
        
        // 2. GameHintManagerの確認
        DiagnoseGameHintManager();
        
        // 3. ボタンとイベントの確認
        DiagnoseButtons();
        
        // 4. 問題があれば自動修復
        if (performCompleteFix)
        {
            yield return StartCoroutine(PerformFixes());
        }
        
        // 5. 最終確認
        yield return new WaitForEndOfFrame();
        FinalVerification();
        
        Debug.Log("=== ヒントシーン診断完了 ===");
    }
    
    /// <summary>
    /// 基本UI要素の診断
    /// </summary>
    private void DiagnoseBasicElements()
    {
        Debug.Log("[診断] 基本UI要素をチェック中...");
        
        // Canvas確認
        Canvas canvas = FindObjectOfType<Canvas>();
        canvasExists = (canvas != null);
        Debug.Log($"Canvas: {(canvasExists ? "✓存在" : "✗不足")}");
        
        // EventSystem確認
        UnityEngine.EventSystems.EventSystem eventSystem = FindObjectOfType<UnityEngine.EventSystems.EventSystem>();
        eventSystemExists = (eventSystem != null);
        Debug.Log($"EventSystem: {(eventSystemExists ? "✓存在" : "✗不足")}");
        
        if (!canvasExists || !eventSystemExists)
        {
            Debug.LogWarning("[診断] 基本UI要素が不足しています。ボタンクリックが動作しません。");
        }
    }
    
    /// <summary>
    /// GameHintManagerの診断
    /// </summary>
    private void DiagnoseGameHintManager()
    {
        Debug.Log("[診断] GameHintManagerをチェック中...");
        
        GameHintManager hintManager = FindObjectOfType<GameHintManager>();
        gameHintManagerExists = (hintManager != null);
        Debug.Log($"GameHintManager: {(gameHintManagerExists ? "✓存在" : "✗不足")}");
        
        if (gameHintManagerExists)
        {
            // UI参照の確認
            CheckHintManagerUIReferences(hintManager);
        }
    }
    
    /// <summary>
    /// GameHintManagerのUI参照確認
    /// </summary>
    private void CheckHintManagerUIReferences(GameHintManager hintManager)
    {
        Debug.Log("[診断] GameHintManagerのUI参照をチェック中...");
        
        // リフレクションでprivateフィールドを確認
        var fields = new string[] { "categoryButtons", "hintSelectionButtons", "backButton", "mainMenuButton" };
        
        foreach (string fieldName in fields)
        {
            var field = typeof(GameHintManager).GetField(fieldName, 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public);
            
            if (field != null)
            {
                object value = field.GetValue(hintManager);
                bool hasValue = (value != null);
                
                if (fieldName.Contains("Buttons") && hasValue)
                {
                    // 配列の場合、null要素をチェック
                    if (value is Button[] buttons)
                    {
                        int nonNullCount = 0;
                        foreach (Button btn in buttons)
                        {
                            if (btn != null) nonNullCount++;
                        }
                        Debug.Log($"  {fieldName}: {nonNullCount}/{buttons.Length} 個のボタンが設定済み");
                    }
                }
                else
                {
                    Debug.Log($"  {fieldName}: {(hasValue ? "✓設定済み" : "✗未設定")}");
                }
            }
            else
            {
                Debug.LogWarning($"  {fieldName}: フィールドが見つかりません");
            }
        }
    }
    
    /// <summary>
    /// ボタンの診断
    /// </summary>
    private void DiagnoseButtons()
    {
        Debug.Log("[診断] ボタンをチェック中...");
        
        Button[] allButtons = FindObjectsOfType<Button>();
        buttonsExist = (allButtons.Length > 0);
        Debug.Log($"シーン内のボタン数: {allButtons.Length}");
        
        if (buttonsExist)
        {
            int buttonsWithListeners = 0;
            foreach (Button btn in allButtons)
            {
                if (btn.onClick.GetPersistentEventCount() > 0 || HasRuntimeListeners(btn))
                {
                    buttonsWithListeners++;
                }
                Debug.Log($"  ボタン '{btn.name}': リスナー数 = {btn.onClick.GetPersistentEventCount()}");
            }
            
            buttonsHaveListeners = (buttonsWithListeners > 0);
            Debug.Log($"イベントリスナーを持つボタン: {buttonsWithListeners}/{allButtons.Length}");
        }
    }
    
    /// <summary>
    /// ボタンにランタイムリスナーがあるかチェック
    /// </summary>
    private bool HasRuntimeListeners(Button button)
    {
        // UnityEventの内部構造にアクセスしてランタイムリスナーを確認
        var onClickField = typeof(Button).GetField("m_OnClick", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (onClickField != null)
        {
            var onClick = onClickField.GetValue(button);
            if (onClick != null)
            {
                var runtimeCallsField = onClick.GetType().GetField("m_RuntimeCalls", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
                if (runtimeCallsField != null)
                {
                    var runtimeCalls = runtimeCallsField.GetValue(onClick);
                    return runtimeCalls != null;
                }
            }
        }
        return false;
    }
    
    /// <summary>
    /// 修復処理を実行
    /// </summary>
    private System.Collections.IEnumerator PerformFixes()
    {
        Debug.Log("[修復] 自動修復を開始します...");
        
        // Canvas修復
        if (!canvasExists)
        {
            CreateCanvas();
            yield return new WaitForEndOfFrame();
        }
        
        // EventSystem修復
        if (!eventSystemExists)
        {
            CreateEventSystem();
            yield return new WaitForEndOfFrame();
        }
        
        // GameHintManager修復
        if (!gameHintManagerExists)
        {
            CreateGameHintManager();
            yield return new WaitForEndOfFrame();
        }
        
        // UI生成と接続
        yield return StartCoroutine(GenerateAndConnectUI());
        
        Debug.Log("[修復] 自動修復が完了しました");
    }
    
    /// <summary>
    /// Canvasを作成
    /// </summary>
    private void CreateCanvas()
    {
        Debug.Log("[修復] Canvasを作成中...");
        
        GameObject canvasObj = new GameObject("Canvas");
        Canvas canvas = canvasObj.AddComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        canvas.sortingOrder = 0;
        
        CanvasScaler scaler = canvasObj.AddComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920, 1080);
        
        canvasObj.AddComponent<GraphicRaycaster>();
        
        Debug.Log("[修復] Canvas作成完了");
    }
    
    /// <summary>
    /// EventSystemを作成
    /// </summary>
    private void CreateEventSystem()
    {
        Debug.Log("[修復] EventSystemを作成中...");
        
        GameObject eventObj = new GameObject("EventSystem");
        eventObj.AddComponent<UnityEngine.EventSystems.EventSystem>();
        eventObj.AddComponent<UnityEngine.EventSystems.StandaloneInputModule>();
        
        Debug.Log("[修復] EventSystem作成完了");
    }
    
    /// <summary>
    /// GameHintManagerを作成
    /// </summary>
    private void CreateGameHintManager()
    {
        Debug.Log("[修復] GameHintManagerを作成中...");
        
        GameObject managerObj = new GameObject("GameHintManager");
        managerObj.AddComponent<GameHintManager>();
        
        Debug.Log("[修復] GameHintManager作成完了");
    }
    
    /// <summary>
    /// UIを生成して接続
    /// </summary>
    private System.Collections.IEnumerator GenerateAndConnectUI()
    {
        Debug.Log("[修復] UIを生成・接続中...");
        
        // HintUIGeneratorでUI生成
        HintUIGenerator generator = FindObjectOfType<HintUIGenerator>();
        if (generator == null)
        {
            GameObject generatorObj = new GameObject("HintUIGenerator");
            generator = generatorObj.AddComponent<HintUIGenerator>();
        }
        
        generator.GenerateHintUI();
        yield return new WaitForEndOfFrame();
        
        // HintManagerAutoSetupで接続
        HintManagerAutoSetup autoSetup = FindObjectOfType<HintManagerAutoSetup>();
        if (autoSetup == null)
        {
            GameObject setupObj = new GameObject("HintManagerAutoSetup");
            autoSetup = setupObj.AddComponent<HintManagerAutoSetup>();
        }
        
        GameHintManager hintManager = FindObjectOfType<GameHintManager>();
        if (hintManager != null)
        {
            autoSetup.hintManager = hintManager;
            autoSetup.AutoSetupHintManager();
        }
        
        yield return new WaitForEndOfFrame();
        
        Debug.Log("[修復] UI生成・接続完了");
    }
    
    /// <summary>
    /// 最終確認
    /// </summary>
    private void FinalVerification()
    {
        Debug.Log("[確認] 最終動作確認中...");
        
        // 再診断
        DiagnoseBasicElements();
        DiagnoseGameHintManager();
        DiagnoseButtons();
        
        // 結果表示
        bool allGood = canvasExists && eventSystemExists && gameHintManagerExists && buttonsExist;
        
        if (allGood)
        {
            Debug.Log("🎉 [成功] ヒントシーンのセットアップが完了しました！");
            Debug.Log("ボタンクリックが正常に動作するはずです。");
            
            // テスト実行を提案
            Debug.Log("💡 [提案] HintUITesterを使用して動作をテストしてください。");
        }
        else
        {
            Debug.LogWarning("⚠️ [注意] まだ問題が残っている可能性があります。");
            Debug.Log("手動で以下を確認してください：");
            if (!canvasExists) Debug.Log("- Canvas");
            if (!eventSystemExists) Debug.Log("- EventSystem");
            if (!gameHintManagerExists) Debug.Log("- GameHintManager");
            if (!buttonsExist) Debug.Log("- UI Buttons");
        }
    }
    
    /// <summary>
    /// 手動でGameHintManagerの初期化を強制実行
    /// </summary>
    [ContextMenu("Force GameHintManager Setup")]
    public void ForceGameHintManagerSetup()
    {
        Debug.Log("[手動] GameHintManagerのセットアップを強制実行中...");
        
        GameHintManager hintManager = FindObjectOfType<GameHintManager>();
        if (hintManager != null)
        {
            // 初期化メソッドを強制呼び出し
            hintManager.SendMessage("InitializeHintDatabase", SendMessageOptions.DontRequireReceiver);
            hintManager.SendMessage("SetupButtons", SendMessageOptions.DontRequireReceiver);
            hintManager.SendMessage("AutoDetectUIElements", SendMessageOptions.DontRequireReceiver);
            
            Debug.Log("[手動] GameHintManagerの強制セットアップ完了");
        }
        else
        {
            Debug.LogError("[手動] GameHintManagerが見つかりません");
        }
    }
    
    /// <summary>
    /// クイックテスト用ボタンを作成
    /// </summary>
    [ContextMenu("Create Quick Test Button")]
    public void CreateQuickTestButton()
    {
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null) return;
        
        GameObject buttonObj = new GameObject("QuickTestButton");
        buttonObj.transform.SetParent(canvas.transform, false);
        
        RectTransform rect = buttonObj.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.5f, 0.1f);
        rect.anchorMax = new Vector2(0.9f, 0.2f);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        Image image = buttonObj.AddComponent<Image>();
        image.color = Color.red;
        
        Button button = buttonObj.AddComponent<Button>();
        button.onClick.AddListener(() => {
            Debug.Log("🎯 クイックテストボタンが押されました！ボタンクリックは動作しています！");
        });
        
        // テキスト追加
        GameObject textObj = new GameObject("Text");
        textObj.transform.SetParent(buttonObj.transform, false);
        
        Text text = textObj.AddComponent<Text>();
        text.text = "テストボタン - クリックしてください";
        text.font = UIUtility.GetDefaultFont();
        text.fontSize = 14;
        text.alignment = TextAnchor.MiddleCenter;
        text.color = Color.white;
        
        RectTransform textRect = textObj.GetComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.offsetMin = Vector2.zero;
        textRect.offsetMax = Vector2.zero;
        
        Debug.Log("📋 クイックテストボタンを作成しました。このボタンをクリックしてUI動作を確認してください。");
    }
}
