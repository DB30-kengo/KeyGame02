using UnityEngine;
using UnityEngine.UI;
using System.Collections.Generic;

/// <summary>
/// シンプルで使いやすい新しいヒントシステム
/// ゲーム画面に被らず、最小限のUIで必要な情報を提供
/// </summary>
public class SimpleHintDisplay : MonoBehaviour
{
    [Header("表示設定")]
    [Tooltip("ヒント表示キー")]
    public KeyCode hintKey = KeyCode.H;
    
    [Tooltip("ヒント表示時間（秒）")]
    public float displayTime = 5f;
    
    [Tooltip("フェードイン・アウト時間")]
    public float fadeTime = 0.5f;
    
    [Header("UI設定")]
    [Tooltip("ヒント表示位置")]
    public HintPosition position = HintPosition.TopRight;
    
    [Tooltip("背景色")]
    public Color backgroundColor = new Color(0, 0, 0, 0.8f);
    
    [Tooltip("テキスト色")]
    public Color textColor = Color.white;
    
    [Tooltip("フォントサイズ")]
    public int fontSize = 16;
    
    // UI要素
    private GameObject hintPanel;
    private Text hintText;
    private CanvasGroup canvasGroup;
    private Canvas hintCanvas;
    
    // 状態管理
    private bool isDisplaying = false;
    private int currentHintIndex = 0;
    private Coroutine displayCoroutine;
    
    // ヒントデータ
    private List<string> currentHints = new List<string>();
    
    // ヒントデータベース（シンプル版）
    private Dictionary<string, List<string>> hintDatabase;
    
    public enum HintPosition
    {
        TopLeft,
        TopRight,
        BottomLeft,
        BottomRight,
        Center
    }
    
    void Start()
    {
        InitializeHintDatabase();
        CreateHintUI();
        Debug.Log($"[SimpleHintDisplay] シンプルヒントシステム準備完了 - {hintKey}キーで表示");
    }
    
    void Update()
    {
        if (Input.GetKeyDown(hintKey))
        {
            if (isDisplaying)
            {
                NextHint();
            }
            else
            {
                ShowRandomHint();
            }
        }
        
        // ESCキーで非表示
        if (Input.GetKeyDown(KeyCode.Escape) && isDisplaying)
        {
            HideHint();
        }
    }
    
    /// <summary>
    /// シンプルなヒントデータベースを初期化
    /// </summary>
    void InitializeHintDatabase()
    {
        hintDatabase = new Dictionary<string, List<string>>();
        
        // 基本操作ヒント
        hintDatabase["basic"] = new List<string>
        {
            "💡 WASD - 移動",
            "💡 マウス - 視点変更", 
            "💡 クリック - 選択・回答",
            "💡 H - ヒント表示",
            "💡 ESC - ヒント非表示"
        };
        
        // 暗号ヒント
        hintDatabase["crypto"] = new List<string>
        {
            "🔐 共通鍵暗号：同じ鍵で暗号化・復号化",
            "🗝️ 公開鍵暗号：公開鍵と秘密鍵のペア",
            "🔗 ハイブリッド暗号：両方式の組み合わせ",
            "⚡ AES：最も広く使われる共通鍵暗号",
            "🛡️ RSA：代表的な公開鍵暗号"
        };
        
        // ゲームヒント
        hintDatabase["game"] = new List<string>
        {
            "🎯 正解するとプレイヤーが次の位置に移動",
            "❌ 間違えてももう一度挑戦できます",
            "📚 問題がわからない時はヒントを活用",
            "🏃 Shiftキーで走ることができます",
            "🔄 複数のヒントを順番に見れます"
        };
        
        Debug.Log("[SimpleHintDisplay] ヒントデータベース初期化完了");
    }
    
    /// <summary>
    /// シンプルなヒントUIを作成
    /// </summary>
    void CreateHintUI()
    {
        // 専用Canvasを作成
        GameObject canvasObj = new GameObject("SimpleHintCanvas");
        hintCanvas = canvasObj.AddComponent<Canvas>();
        hintCanvas.renderMode = RenderMode.ScreenSpaceOverlay;
        hintCanvas.sortingOrder = 100; // 最前面
        
        CanvasScaler scaler = canvasObj.AddComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920, 1080);
        
        canvasObj.AddComponent<GraphicRaycaster>();
        
        // ヒントパネル作成
        hintPanel = new GameObject("HintPanel");
        hintPanel.transform.SetParent(hintCanvas.transform, false);
        
        // 背景設定
        Image background = hintPanel.AddComponent<Image>();
        background.color = backgroundColor;
        
        // 位置とサイズ設定
        RectTransform panelRect = hintPanel.GetComponent<RectTransform>();
        SetPanelPosition(panelRect);
        
        // フェード用CanvasGroup
        canvasGroup = hintPanel.AddComponent<CanvasGroup>();
        canvasGroup.alpha = 0f;
        
        // テキスト作成
        GameObject textObj = new GameObject("HintText");
        textObj.transform.SetParent(hintPanel.transform, false);
        
        hintText = textObj.AddComponent<Text>();
        hintText.font = GetSafeFont();
        hintText.fontSize = fontSize;
        hintText.color = textColor;
        hintText.alignment = TextAnchor.MiddleCenter;
        hintText.lineSpacing = 1.2f;
        
        RectTransform textRect = textObj.GetComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.offsetMin = new Vector2(10, 10);
        textRect.offsetMax = new Vector2(-10, -10);
        
        // 最初は非表示
        hintPanel.SetActive(false);
        
        Debug.Log("[SimpleHintDisplay] シンプルなヒントUI作成完了");
    }
    
    /// <summary>
    /// パネルの位置を設定
    /// </summary>
    void SetPanelPosition(RectTransform panelRect)
    {
        Vector2 size = new Vector2(300, 100);
        panelRect.sizeDelta = size;
        
        switch (position)
        {
            case HintPosition.TopLeft:
                panelRect.anchorMin = Vector2.zero;
                panelRect.anchorMax = Vector2.zero;
                panelRect.anchoredPosition = new Vector2(size.x * 0.5f + 20, Screen.height - size.y * 0.5f - 20);
                break;
                
            case HintPosition.TopRight:
                panelRect.anchorMin = Vector2.one;
                panelRect.anchorMax = Vector2.one;
                panelRect.anchoredPosition = new Vector2(-size.x * 0.5f - 20, -size.y * 0.5f - 20);
                break;
                
            case HintPosition.BottomLeft:
                panelRect.anchorMin = Vector2.zero;
                panelRect.anchorMax = Vector2.zero;
                panelRect.anchoredPosition = new Vector2(size.x * 0.5f + 20, size.y * 0.5f + 20);
                break;
                
            case HintPosition.BottomRight:
                panelRect.anchorMin = new Vector2(1, 0);
                panelRect.anchorMax = new Vector2(1, 0);
                panelRect.anchoredPosition = new Vector2(-size.x * 0.5f - 20, size.y * 0.5f + 20);
                break;
                
            case HintPosition.Center:
                panelRect.anchorMin = new Vector2(0.5f, 0.5f);
                panelRect.anchorMax = new Vector2(0.5f, 0.5f);
                panelRect.anchoredPosition = Vector2.zero;
                break;
        }
    }
    
    /// <summary>
    /// ランダムなヒントを表示
    /// </summary>
    public void ShowRandomHint()
    {
        string[] categories = { "basic", "crypto", "game" };
        string randomCategory = categories[Random.Range(0, categories.Length)];
        ShowCategoryHints(randomCategory);
    }
    
    /// <summary>
    /// 指定カテゴリのヒントを表示
    /// </summary>
    public void ShowCategoryHints(string category)
    {
        if (!hintDatabase.ContainsKey(category))
        {
            Debug.LogWarning($"[SimpleHintDisplay] カテゴリが見つかりません: {category}");
            return;
        }
        
        currentHints = hintDatabase[category];
        currentHintIndex = 0;
        DisplayCurrentHint();
    }
    
    /// <summary>
    /// 次のヒントを表示
    /// </summary>
    public void NextHint()
    {
        if (currentHints.Count == 0) return;
        
        currentHintIndex = (currentHintIndex + 1) % currentHints.Count;
        DisplayCurrentHint();
    }
    
    /// <summary>
    /// 現在のヒントを表示
    /// </summary>
    void DisplayCurrentHint()
    {
        if (currentHints.Count == 0) return;
        
        string hintContent = currentHints[currentHintIndex];
        
        // 複数ヒントがある場合はページ表示
        if (currentHints.Count > 1)
        {
            hintContent += $"\n\n({currentHintIndex + 1}/{currentHints.Count}) - Hキー：次へ";
        }
        
        hintText.text = hintContent;
        
        if (displayCoroutine != null)
        {
            StopCoroutine(displayCoroutine);
        }
        
        displayCoroutine = StartCoroutine(ShowHintCoroutine());
    }
    
    /// <summary>
    /// ヒント表示のコルーチン
    /// </summary>
    System.Collections.IEnumerator ShowHintCoroutine()
    {
        isDisplaying = true;
        hintPanel.SetActive(true);
        
        // フェードイン
        float elapsedTime = 0f;
        while (elapsedTime < fadeTime)
        {
            canvasGroup.alpha = Mathf.Lerp(0f, 1f, elapsedTime / fadeTime);
            elapsedTime += Time.deltaTime;
            yield return null;
        }
        canvasGroup.alpha = 1f;
        
        // 表示時間待機
        yield return new WaitForSeconds(displayTime);
        
        // フェードアウト
        elapsedTime = 0f;
        while (elapsedTime < fadeTime)
        {
            canvasGroup.alpha = Mathf.Lerp(1f, 0f, elapsedTime / fadeTime);
            elapsedTime += Time.deltaTime;
            yield return null;
        }
        canvasGroup.alpha = 0f;
        
        hintPanel.SetActive(false);
        isDisplaying = false;
    }
    
    /// <summary>
    /// ヒントを即座に非表示
    /// </summary>
    public void HideHint()
    {
        if (displayCoroutine != null)
        {
            StopCoroutine(displayCoroutine);
        }
        
        canvasGroup.alpha = 0f;
        hintPanel.SetActive(false);
        isDisplaying = false;
        
        Debug.Log("[SimpleHintDisplay] ヒント非表示");
    }
    
    /// <summary>
    /// 安全なフォント取得
    /// </summary>
    Font GetSafeFont()
    {
        Font font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        if (font == null)
        {
            font = Resources.GetBuiltinResource<Font>("Arial.ttf");
        }
        return font;
    }
    
    /// <summary>
    /// 外部からの特定ヒント表示
    /// </summary>
    public void ShowSpecificHint(string hint)
    {
        currentHints = new List<string> { hint };
        currentHintIndex = 0;
        DisplayCurrentHint();
    }
    
    /// <summary>
    /// 基本操作ヒントを表示
    /// </summary>
    public void ShowBasicHints()
    {
        ShowCategoryHints("basic");
    }
    
    /// <summary>
    /// 暗号ヒントを表示
    /// </summary>
    public void ShowCryptoHints()
    {
        ShowCategoryHints("crypto");
    }
    
    /// <summary>
    /// ゲームヒントを表示
    /// </summary>
    public void ShowGameHints()
    {
        ShowCategoryHints("game");
    }
    
    /// <summary>
    /// カスタムヒントを追加
    /// </summary>
    public void AddCustomHint(string category, string hint)
    {
        if (!hintDatabase.ContainsKey(category))
        {
            hintDatabase[category] = new List<string>();
        }
        
        hintDatabase[category].Add(hint);
        Debug.Log($"[SimpleHintDisplay] カスタムヒント追加: {category} - {hint}");
    }
    
    void OnGUI()
    {
        // 左下に簡単な操作ガイド
        GUIStyle style = new GUIStyle(GUI.skin.label);
        style.fontSize = 12;
        style.normal.textColor = Color.white;
        
        GUI.Label(new Rect(10, Screen.height - 50, 200, 40), 
                 $"💡 {hintKey}: ヒント表示\nESC: 非表示", style);
    }
}
