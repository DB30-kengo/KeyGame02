using UnityEngine;
using UnityEngine.SceneManagement;
using UnityEngine.UI;

/// <summary>
/// メインゲームからヒントシステムを起動するトリガー
/// </summary>
public class HintSystemLauncher : MonoBehaviour
{
    [Header("UI Settings")]
    [Tooltip("ヒントボタン（自動生成される場合は空でOK）")]
    public Button hintButton;
    
    [Header("Scene Settings")]
    [Tooltip("ヒントシーン名")]
    public string hintSceneName = "HintScene";
    
    [Header("Key Bindings")]
    [Tooltip("ヒントを開くキー")]
    public KeyCode hintKey = KeyCode.H;
    
    void Start()
    {
        SetupHintButton();
        SaveCurrentScene();
    }
    
    void Update()
    {
        // キーボードショートカット
        if (Input.GetKeyDown(hintKey))
        {
            LaunchHintSystem();
        }
    }
    
    /// <summary>
    /// ヒントボタンのセットアップ
    /// </summary>
    private void SetupHintButton()
    {
        // ヒントボタンが設定されていない場合は自動生成
        if (hintButton == null)
        {
            CreateHintButton();
        }
        
        // ボタンイベントを設定
        if (hintButton != null)
        {
            hintButton.onClick.RemoveAllListeners();
            hintButton.onClick.AddListener(LaunchHintSystem);
            Debug.Log("[HintSystemLauncher] ヒントボタンが設定されました");
        }
    }
    
    /// <summary>
    /// ヒントボタンを自動生成
    /// </summary>
    private void CreateHintButton()
    {
        // Canvasを探す
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            Debug.LogWarning("[HintSystemLauncher] Canvasが見つかりません。ヒントボタンを作成できません。");
            return;
        }
        
        // ヒントボタンオブジェクトを作成
        GameObject buttonObj = new GameObject("HintButton");
        buttonObj.transform.SetParent(canvas.transform, false);
        
        // RectTransformを設定（画面右上に配置）
        RectTransform buttonRect = buttonObj.AddComponent<RectTransform>();
        buttonRect.anchorMin = new Vector2(0.85f, 0.85f);
        buttonRect.anchorMax = new Vector2(0.98f, 0.98f);
        buttonRect.offsetMin = Vector2.zero;
        buttonRect.offsetMax = Vector2.zero;
        
        // ボタンコンポーネントを追加
        hintButton = buttonObj.AddComponent<Button>();
        Image buttonImage = buttonObj.AddComponent<Image>();
        buttonImage.color = new Color(0.2f, 0.6f, 0.8f, 0.8f);
        
        // ボタンテキストを作成
        GameObject textObj = new GameObject("Text");
        textObj.transform.SetParent(buttonObj.transform, false);
        
        Text buttonText = textObj.AddComponent<Text>();
        buttonText.text = "💡\nヒント";
        buttonText.font = UIUtility.GetDefaultFont();
        buttonText.fontSize = 14;
        buttonText.color = Color.white;
        buttonText.alignment = TextAnchor.MiddleCenter;
        
        RectTransform textRect = textObj.GetComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.offsetMin = Vector2.zero;
        textRect.offsetMax = Vector2.zero;
        
        Debug.Log("[HintSystemLauncher] ヒントボタンを自動生成しました");
    }
    
    /// <summary>
    /// 現在のシーン情報を保存
    /// </summary>
    private void SaveCurrentScene()
    {
        string currentScene = SceneManager.GetActiveScene().name;
        PlayerPrefs.SetString("PreviousScene", currentScene);
        Debug.Log($"[HintSystemLauncher] 現在のシーンを保存: {currentScene}");
    }
    
    /// <summary>
    /// ヒントシステムを起動
    /// </summary>
    public void LaunchHintSystem()
    {
        Debug.Log("[HintSystemLauncher] ヒントシステムを起動中...");
        
        // 現在のカーソル状態を保存
        SaveCursorState();
        
        // 現在のシーン情報を保存
        SaveCurrentScene();
        
        // ヒントシーンに切り替え
        SceneManager.LoadScene(hintSceneName);
    }
    
    /// <summary>
    /// カーソル状態を保存
    /// </summary>
    private void SaveCursorState()
    {
        PlayerPrefs.SetInt("HintLauncher_PreviousCursorLockState", (int)Cursor.lockState);
        PlayerPrefs.SetInt("HintLauncher_PreviousCursorVisible", Cursor.visible ? 1 : 0);
        Debug.Log($"[HintSystemLauncher] カーソル状態を保存: LockState={Cursor.lockState}, Visible={Cursor.visible}");
    }
    
    /// <summary>
    /// 手動でヒントボタンを設定
    /// </summary>
    [ContextMenu("Setup Hint Button")]
    public void SetupHintButtonManually()
    {
        SetupHintButton();
    }
    
    /// <summary>
    /// 手動でヒントボタンを作成
    /// </summary>
    [ContextMenu("Create Hint Button")]
    public void CreateHintButtonManually()
    {
        CreateHintButton();
    }
}
