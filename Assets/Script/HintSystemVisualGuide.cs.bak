using UnityEngine;
using UnityEngine.UI;

/// <summary>
/// ヒントシステムの動作を画面上で視覚的に説明するガイド表示
/// ゲーム実行中にリアルタイムで操作説明を表示
/// </summary>
public class HintSystemVisualGuide : MonoBehaviour
{
    [Header("表示設定")]
    public bool showGuideOnStart = true;
    public bool enableKeyboardShortcuts = true;
    
    [Header("ガイド表示時間")]
    public float initialDisplayTime = 8f;
    public float fadeOutTime = 2f;
    
    private GameObject guideUI;
    private Text guideText;
    private Image guideBackground;
    private bool isGuideVisible = false;
    private float displayTimer = 0f;
    
    // ヒントシステム関連の参照
    private Button hintButton;
    private HintSystemLauncher hintLauncher;
    
    void Start()
    {
        // ヒントシステムコンポーネントを検索
        FindHintSystemComponents();
        
        if (showGuideOnStart)
        {
            CreateVisualGuide();
            Invoke("ShowInitialGuide", 1f); // 1秒後に表示
        }
        
        Debug.Log("[HintSystemVisualGuide] Visual guide initialized. Press F1 to show/hide guide.");
    }
    
    void Update()
    {
        if (enableKeyboardShortcuts)
        {
            // F1でガイド表示切り替え
            if (Input.GetKeyDown(KeyCode.F1))
            {
                ToggleGuide();
            }
            
            // ヒント関連キーの監視とガイド表示
            if (Input.GetKeyDown(KeyCode.H))
            {
                ShowQuickMessage("Hキーが押されました！\nヒントシステムが起動します...", 3f);
            }
        }
        
        // タイマー管理
        if (isGuideVisible && displayTimer > 0)
        {
            displayTimer -= Time.deltaTime;
            if (displayTimer <= 0)
            {
                HideGuide();
            }
        }
    }
    
    void FindHintSystemComponents()
    {
        // ヒントボタンを検索
        hintButton = FindObjectOfType<Button>();
        if (hintButton != null && hintButton.name.Contains("Hint"))
        {
            Debug.Log($"[HintSystemVisualGuide] Hint button found: {hintButton.name}");
        }
        
        // HintSystemLauncherを検索
        hintLauncher = FindObjectOfType<HintSystemLauncher>();
        if (hintLauncher != null)
        {
            Debug.Log("[HintSystemVisualGuide] HintSystemLauncher found");
        }
    }
    
    void CreateVisualGuide()
    {
        // Canvas取得または作成
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            GameObject canvasObj = new GameObject("GuideCanvas");
            canvas = canvasObj.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvas.sortingOrder = 999; // 最前面
        }
        
        // ガイドUIコンテナ作成
        guideUI = new GameObject("HintSystemGuide");
        guideUI.transform.SetParent(canvas.transform, false);
        
        // 背景
        guideBackground = guideUI.AddComponent<Image>();
        guideBackground.color = new Color(0, 0, 0, 0.8f);
        
        RectTransform bgRect = guideUI.GetComponent<RectTransform>();
        bgRect.anchorMin = new Vector2(0.1f, 0.3f);
        bgRect.anchorMax = new Vector2(0.9f, 0.7f);
        bgRect.offsetMin = Vector2.zero;
        bgRect.offsetMax = Vector2.zero;
        
        // ガイドテキスト作成
        GameObject textObj = new GameObject("GuideText");
        textObj.transform.SetParent(guideUI.transform, false);
        
        guideText = textObj.AddComponent<Text>();
        guideText.font = UIUtility.GetDefaultFont();
        guideText.fontSize = 18;
        guideText.color = Color.white;
        guideText.alignment = TextAnchor.UpperLeft;
        guideText.lineSpacing = 1.2f;
        
        RectTransform textRect = textObj.GetComponent<RectTransform>();
        textRect.anchorMin = new Vector2(0.05f, 0.05f);
        textRect.anchorMax = new Vector2(0.95f, 0.95f);
        textRect.offsetMin = Vector2.zero;
        textRect.offsetMax = Vector2.zero;
        
        // 最初は非表示
        guideUI.SetActive(false);
        
        Debug.Log("[HintSystemVisualGuide] Visual guide UI created");
    }
    
    void ShowInitialGuide()
    {
        string guideMessage = BuildInitialGuideMessage();
        ShowGuideWithMessage(guideMessage);
        displayTimer = initialDisplayTime;
    }
    
    string BuildInitialGuideMessage()
    {
        string message = "🎮 <color=yellow>暗号学習ゲーム - ヒントシステム</color> 🎮\n\n";
        
        message += "<color=cyan>【新機能追加】</color>\n";
        message += "画面右上に「💡 ヒント」ボタンが追加されました！\n\n";
        
        message += "<color=lime>【使用方法】</color>\n";
        message += "1️⃣ <color=yellow>H</color> キーを押す\n";
        message += "2️⃣ 右上の <color=yellow>💡 ヒント</color> ボタンをクリック\n\n";
        
        message += "<color=orange>【ヒントの内容】</color>\n";
        message += "🔐 共通鍵暗号　　🗝️ 公開鍵暗号\n";
        message += "🔗 ハイブリッド暗号　🎮 ゲーム操作\n";
        message += "📚 一般ヒント\n\n";
        
        message += "<color=lightblue>【シーン切り替え】</color>\n";
        message += "• ヒント表示 → 専用のヒントシーンに移動\n";
        message += "• 「メインゲームに戻る」→ 元の画面に復帰\n";
        message += "• カーソル状態も自動で復元されます\n\n";
        
        message += "<color=gray>F1キーでこのガイドを再表示　　8秒後に自動非表示</color>";
        
        return message;
    }
    
    void ShowGuideWithMessage(string message)
    {
        if (guideUI == null) return;
        
        guideText.text = message;
        guideUI.SetActive(true);
        isGuideVisible = true;
        
        Debug.Log("[HintSystemVisualGuide] Guide displayed");
    }
    
    void ToggleGuide()
    {
        if (isGuideVisible)
        {
            HideGuide();
        }
        else
        {
            ShowInitialGuide();
        }
    }
    
    void HideGuide()
    {
        if (guideUI != null)
        {
            guideUI.SetActive(false);
        }
        isGuideVisible = false;
        displayTimer = 0f;
        
        Debug.Log("[HintSystemVisualGuide] Guide hidden");
    }
    
    public void ShowQuickMessage(string message, float duration = 3f)
    {
        if (guideUI == null) CreateVisualGuide();
        
        ShowGuideWithMessage(message);
        displayTimer = duration;
    }
    
    public void ShowDetailedOperationGuide()
    {
        string detailedMessage = "<color=yellow>🎯 ヒントシステム詳細ガイド</color>\n\n";
        
        detailedMessage += "<color=lime>【ステップ１】ヒント起動</color>\n";
        detailedMessage += "• <color=yellow>H</color>キー または 右上の<color=yellow>💡</color>ボタン\n";
        detailedMessage += "• シーンが「HintScene」に切り替わります\n\n";
        
        detailedMessage += "<color=lime>【ステップ２】カテゴリ選択</color>\n";
        detailedMessage += "• 5つのカテゴリから選択\n";
        detailedMessage += "• 各カテゴリには3-4個のヒント項目\n\n";
        
        detailedMessage += "<color=lime>【ステップ３】ヒント詳細確認</color>\n";
        detailedMessage += "• タイトル、詳細内容、追加情報を表示\n";
        detailedMessage += "• 「ヒント一覧に戻る」で前画面へ\n\n";
        
        detailedMessage += "<color=lime>【ステップ４】ゲームに復帰</color>\n";
        detailedMessage += "• 「メインゲームに戻る」ボタン\n";
        detailedMessage += "• 元のゲームシーンに自動復帰\n\n";
        
        detailedMessage += "<color=cyan>💡 便利機能</color>\n";
        detailedMessage += "• カーソル状態の自動保存・復元\n";
        detailedMessage += "• いつでもHキーで瞬時起動\n";
        detailedMessage += "• 学習進度に応じたヒント表示";
        
        ShowGuideWithMessage(detailedMessage);
        displayTimer = 12f; // 長めに表示
    }
    
    void OnGUI()
    {
        // 簡易操作パネル（画面左下）
        GUILayout.BeginArea(new Rect(10, Screen.height - 100, 300, 90));
        
        GUIStyle style = new GUIStyle(GUI.skin.label);
        style.fontSize = 12;
        style.normal.textColor = Color.white;
        
        GUILayout.Label("🎮 ヒントシステム", style);
        GUILayout.Label("H : ヒント起動", style);
        GUILayout.Label("F1: ガイド表示", style);
        
        GUILayout.EndArea();
        
        // ヒントボタンの位置を視覚的に示す（デバッグ用）
        if (hintButton != null && !isGuideVisible)
        {
            Vector3 buttonPos = Camera.main.WorldToScreenPoint(hintButton.transform.position);
            GUI.Label(new Rect(buttonPos.x + 20, Screen.height - buttonPos.y, 200, 30), 
                     "← ヒントボタン", new GUIStyle(GUI.skin.label) { normal = { textColor = Color.yellow } });
        }
    }
    
    // 外部から呼び出し可能な公開メソッド
    public void ShowHintButtonIntroduction()
    {
        ShowQuickMessage("新機能：ヒントボタンが追加されました！\n右上の💡をクリックしてください", 5f);
    }
    
    public void ShowKeyboardShortcutReminder()
    {
        ShowQuickMessage("💡 Hキーでいつでもヒント表示！", 3f);
    }
    
    public void ShowSceneTransitionExplanation()
    {
        ShowQuickMessage("シーン切り替え中...\nヒント専用画面に移動します", 2f);
    }
}
