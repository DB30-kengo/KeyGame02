using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;

/// <summary>
/// ヒントシーンの自動セットアップスクリプト
/// HintSceneに配置して、RealHintSystemを自動的に初期化します
/// </summary>
public class HintSceneAutoSetup : MonoBehaviour
{
    [Header("Settings")]
    [Tooltip("メインゲームシーン名（戻る際に使用）")]
    public string mainGameSceneName = "Chapter_game";
    
    void Start()
    {
        SetupHintScene();
    }
    
    /// <summary>
    /// ヒントシーンのセットアップ
    /// </summary>
    private void SetupHintScene()
    {
        Debug.Log("[HintSceneAutoSetup] ヒントシーンのセットアップを開始");
        
        // 前のシーン名を取得
        string previousScene = PlayerPrefs.GetString("PreviousScene", mainGameSceneName);
        
        // RealHintSystemが存在しない場合は作成
        RealHintSystem hintSystem = FindObjectOfType<RealHintSystem>();
        if (hintSystem == null)
        {
            Debug.Log("[HintSceneAutoSetup] RealHintSystemが見つからないため作成します");
            CreateRealHintSystem(previousScene);
            
            // 作成確認
            hintSystem = FindObjectOfType<RealHintSystem>();
            if (hintSystem != null)
            {
                Debug.Log("[HintSceneAutoSetup] RealHintSystem作成成功");
            }
            else
            {
                Debug.LogError("[HintSceneAutoSetup] RealHintSystem作成失敗");
            }
        }
        else
        {
            // 戻るシーン名を更新
            hintSystem.returnSceneName = previousScene;
            Debug.Log($"[HintSceneAutoSetup] 既存のRealHintSystemを更新: returnScene={previousScene}");
        }
        
        // カメラの設定
        SetupCamera();
        
        // 基本UI要素の確保
        EnsureBasicUIComponents();
        
        Debug.Log("[HintSceneAutoSetup] ヒントシーンのセットアップ完了");
    }
    
    /// <summary>
    /// RealHintSystemを作成
    /// </summary>
    private void CreateRealHintSystem(string returnScene)
    {
        GameObject hintSystemObj = new GameObject("RealHintSystem");
        RealHintSystem hintSystem = hintSystemObj.AddComponent<RealHintSystem>();
        hintSystem.returnSceneName = returnScene;
        
        Debug.Log($"[HintSceneAutoSetup] RealHintSystemを作成: returnScene={returnScene}");
    }
    
    /// <summary>
    /// カメラの設定
    /// </summary>
    private void SetupCamera()
    {
        Camera mainCamera = Camera.main;
        if (mainCamera == null)
        {
            GameObject cameraObj = new GameObject("Main Camera");
            mainCamera = cameraObj.AddComponent<Camera>();
            cameraObj.tag = "MainCamera";
        }
        
        // UI表示に適したカメラ設定
        mainCamera.clearFlags = CameraClearFlags.SolidColor;
        mainCamera.backgroundColor = new Color(0.05f, 0.1f, 0.2f, 1f);
        mainCamera.orthographic = false;
        mainCamera.transform.position = new Vector3(0f, 0f, -10f);
        
        Debug.Log("[HintSceneAutoSetup] カメラを設定しました");
    }
    
    /// <summary>
    /// 基本UI要素を確保
    /// </summary>
    private void EnsureBasicUIComponents()
    {
        // Canvas確認
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            Debug.Log("[HintSceneAutoSetup] Canvas を作成します");
            GameObject canvasObj = new GameObject("Canvas");
            canvas = canvasObj.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvasObj.AddComponent<CanvasScaler>();
            canvasObj.AddComponent<GraphicRaycaster>();
        }
        
        // EventSystem確認
        UnityEngine.EventSystems.EventSystem eventSystem = FindObjectOfType<UnityEngine.EventSystems.EventSystem>();
        if (eventSystem == null)
        {
            Debug.Log("[HintSceneAutoSetup] EventSystem を作成します");
            GameObject eventObj = new GameObject("EventSystem");
            eventObj.AddComponent<UnityEngine.EventSystems.EventSystem>();
            eventObj.AddComponent<UnityEngine.EventSystems.StandaloneInputModule>();
        }
        
        Debug.Log("[HintSceneAutoSetup] 基本UI要素の確保完了");
    }

    /// <summary>
    /// シーンに必要な基本コンポーネントを確保
    /// </summary>
    [ContextMenu("Setup Scene Components")]
    public void SetupSceneComponents()
    {
        SetupHintScene();
    }
}
