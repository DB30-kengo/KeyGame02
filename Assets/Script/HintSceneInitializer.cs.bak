using UnityEngine;
using UnityEngine.UI;
using System.Collections.Generic;

/// <summary>
/// ヒントシーンの完全な初期化と動作確認を行うスクリプト
/// </summary>
public class HintSceneInitializer : MonoBehaviour
{
    [Header("Debug Settings")]
    [Tooltip("詳細なデバッグログを出力")]
    public bool verboseDebug = true;
    
    [Header("Force Setup")]
    [Tooltip("強制的にUI要素を再作成")]
    public bool forceRecreateUI = false;
    
    [Header("Component References")]
    public GameHintManager hintManager;
    public HintUIGenerator uiGenerator;
    
    void Start()
    {
        Debug.Log("[HintSceneInitializer] Starting hint scene initialization...");
        
        if (verboseDebug)
        {
            LogSceneObjects();
        }
        
        InitializeHintScene();
    }
    
    /// <summary>
    /// ヒントシーンの完全初期化
    /// </summary>
    [ContextMenu("Initialize Hint Scene")]
    public void InitializeHintScene()
    {
        Debug.Log("[HintSceneInitializer] Initializing hint scene...");
        
        // 1. 必要なコンポーネントを確保
        EnsureRequiredComponents();
        
        // 2. UI要素を確保
        EnsureUIElements();
        
        // 3. イベントリスナーを設定
        SetupEventListeners();
        
        // 4. カーソル設定
        SetupCursor();
        
        // 5. 動作テスト
        if (verboseDebug)
        {
            TestUIFunctionality();
        }
        
        Debug.Log("[HintSceneInitializer] Hint scene initialization completed!");
    }
    
    /// <summary>
    /// 必要なコンポーネントを確保
    /// </summary>
    private void EnsureRequiredComponents()
    {
        Debug.Log("[HintSceneInitializer] Ensuring required components...");
        
        // GameHintManagerを確保
        if (hintManager == null)
        {
            hintManager = FindObjectOfType<GameHintManager>();
            if (hintManager == null)
            {
                GameObject managerObj = new GameObject("GameHintManager");
                hintManager = managerObj.AddComponent<GameHintManager>();
                Debug.Log("[HintSceneInitializer] Created GameHintManager");
            }
        }
        
        // HintUIGeneratorを確保
        if (uiGenerator == null)
        {
            uiGenerator = FindObjectOfType<HintUIGenerator>();
            if (uiGenerator == null)
            {
                GameObject generatorObj = new GameObject("HintUIGenerator");
                uiGenerator = generatorObj.AddComponent<HintUIGenerator>();
                Debug.Log("[HintSceneInitializer] Created HintUIGenerator");
            }
        }
        
        // Canvasを確保
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            GameObject canvasObj = new GameObject("Canvas");
            canvas = canvasObj.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvasObj.AddComponent<CanvasScaler>();
            canvasObj.AddComponent<GraphicRaycaster>();
            Debug.Log("[HintSceneInitializer] Created Canvas");
        }
        
        // EventSystemを確保
        UnityEngine.EventSystems.EventSystem eventSystem = FindObjectOfType<UnityEngine.EventSystems.EventSystem>();
        if (eventSystem == null)
        {
            GameObject eventObj = new GameObject("EventSystem");
            eventObj.AddComponent<UnityEngine.EventSystems.EventSystem>();
            eventObj.AddComponent<UnityEngine.EventSystems.StandaloneInputModule>();
            Debug.Log("[HintSceneInitializer] Created EventSystem");
        }
    }
    
    /// <summary>
    /// UI要素を確保
    /// </summary>
    private void EnsureUIElements()
    {
        Debug.Log("[HintSceneInitializer] Ensuring UI elements...");
        
        // UIGeneratorでUI要素を生成
        if (uiGenerator != null)
        {
            uiGenerator.GenerateHintUI();
        }
        
        // GameHintManagerのUI参照を設定
        if (hintManager != null)
        {
            StartCoroutine(DelayedUISetup());
        }
    }
    
    /// <summary>
    /// 遅延UI設定（UI生成後に実行）
    /// </summary>
    private System.Collections.IEnumerator DelayedUISetup()
    {
        yield return new UnityEngine.WaitForEndOfFrame();
        
        // HintManagerAutoSetupを使用してUI参照を設定
        HintManagerAutoSetup autoSetup = FindObjectOfType<HintManagerAutoSetup>();
        if (autoSetup == null)
        {
            GameObject setupObj = new GameObject("HintManagerAutoSetup");
            autoSetup = setupObj.AddComponent<HintManagerAutoSetup>();
        }
        
        autoSetup.hintManager = hintManager;
        autoSetup.AutoSetupHintManager();
        
        Debug.Log("[HintSceneInitializer] UI setup completed with delay");
    }
    
    /// <summary>
    /// イベントリスナーを設定
    /// </summary>
    private void SetupEventListeners()
    {
        Debug.Log("[HintSceneInitializer] Setting up event listeners...");
        
        if (hintManager != null)
        {
            // GameHintManagerの初期化を強制実行
            hintManager.SendMessage("InitializeHintDatabase", SendMessageOptions.DontRequireReceiver);
            hintManager.SendMessage("SetupButtons", SendMessageOptions.DontRequireReceiver);
        }
    }
    
    /// <summary>
    /// カーソル設定
    /// </summary>
    private void SetupCursor()
    {
        Cursor.lockState = CursorLockMode.None;
        Cursor.visible = true;
        Debug.Log("[HintSceneInitializer] Cursor set for UI interaction");
    }
    
    /// <summary>
    /// UI機能をテスト
    /// </summary>
    [ContextMenu("Test UI Functionality")]
    public void TestUIFunctionality()
    {
        Debug.Log("[HintSceneInitializer] Testing UI functionality...");
        
        if (hintManager == null)
        {
            Debug.LogError("[HintSceneInitializer] GameHintManager is null!");
            return;
        }
        
        // カテゴリボタンのテスト
        Debug.Log("[HintSceneInitializer] Testing category selection...");
        hintManager.SelectCategory(GameHintManager.HintCategory.SymmetricKey);
        
        // ヒント表示のテスト
        Debug.Log("[HintSceneInitializer] Testing hint display...");
        hintManager.ShowHint(0);
        
        // 戻る機能のテスト
        Debug.Log("[HintSceneInitializer] Testing navigation...");
        hintManager.GoBack();
        
        Debug.Log("[HintSceneInitializer] UI functionality test completed");
    }
    
    /// <summary>
    /// シーン内のオブジェクトをログ出力
    /// </summary>
    private void LogSceneObjects()
    {
        Debug.Log("[HintSceneInitializer] === SCENE OBJECTS DEBUG ===");
        
        // すべてのGameObjectをログ出力
        GameObject[] allObjects = FindObjectsOfType<GameObject>();
        Debug.Log($"[HintSceneInitializer] Total GameObjects: {allObjects.Length}");
        
        // ボタンをログ出力
        Button[] buttons = FindObjectsOfType<Button>();
        Debug.Log($"[HintSceneInitializer] Buttons found: {buttons.Length}");
        foreach (Button btn in buttons)
        {
            Debug.Log($"  - Button: {btn.name}");
        }
        
        // テキストをログ出力
        Text[] texts = FindObjectsOfType<Text>();
        Debug.Log($"[HintSceneInitializer] Text components found: {texts.Length}");
        foreach (Text txt in texts)
        {
            Debug.Log($"  - Text: {txt.name}");
        }
        
        // パネルをログ出力
        foreach (GameObject obj in allObjects)
        {
            if (obj.name.ToLower().Contains("panel"))
            {
                Debug.Log($"  - Panel: {obj.name} (Active: {obj.activeSelf})");
            }
        }
    }
    
    /// <summary>
    /// 緊急UI修復（エディタから実行可能）
    /// </summary>
    [ContextMenu("Emergency UI Fix")]
    public void EmergencyUIFix()
    {
        Debug.Log("[HintSceneInitializer] Starting emergency UI fix...");
        
        forceRecreateUI = true;
        InitializeHintScene();
        
        // 強制的にGameHintManagerを再初期化
        if (hintManager != null)
        {
            DestroyImmediate(hintManager);
        }
        
        // UIGeneratorも再作成
        if (uiGenerator != null)
        {
            DestroyImmediate(uiGenerator);
        }
        
        EnsureRequiredComponents();
        EnsureUIElements();
        
        Debug.Log("[HintSceneInitializer] Emergency UI fix completed!");
    }
}
