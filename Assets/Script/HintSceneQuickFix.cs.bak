using UnityEngine;
using UnityEngine.UI;

/// <summary>
/// ヒントシーンのボタン問題を一発で解決するクイックフィックス
/// </summary>
public class HintSceneQuickFix : MonoBehaviour
{
    [Header("Quick Fix Options")]
    [Tooltip("実行ボタン - これをクリックしてください")]
    public bool executeQuickFix = false;
    
    [Header("Status")]
    public string currentStatus = "準備完了";
    
    void Start()
    {
        Debug.Log("🔧 [QuickFix] ヒントシーンクイックフィックスが準備完了しました");
        Debug.Log("📋 Inspector で 'Execute Quick Fix' にチェックを入れてください");
    }
    
    void Update()
    {
        if (executeQuickFix)
        {
            executeQuickFix = false;
            ExecuteQuickFix();
        }
    }
    
    /// <summary>
    /// ワンクリックでヒントシーンを修復
    /// </summary>
    [ContextMenu("Execute Quick Fix")]
    public void ExecuteQuickFix()
    {
        Debug.Log("🚀 [QuickFix] ヒントシーンの一括修復を開始します...");
        currentStatus = "修復中...";
        
        StartCoroutine(PerformQuickFix());
    }
    
    private System.Collections.IEnumerator PerformQuickFix()
    {
        // ステップ1: 基本要素確保
        currentStatus = "基本要素を確保中...";
        EnsureBasicElements();
        yield return new WaitForEndOfFrame();
        
        // ステップ2: GameHintManager作成
        currentStatus = "GameHintManagerを設定中...";
        EnsureGameHintManager();
        yield return new WaitForEndOfFrame();
        
        // ステップ3: UI生成
        currentStatus = "UIを生成中...";
        GenerateUI();
        yield return new WaitForEndOfFrame();
        
        // ステップ4: 接続設定
        currentStatus = "UI接続を設定中...";
        SetupConnections();
        yield return new WaitForEndOfFrame();
        
        // ステップ5: イベント設定
        currentStatus = "イベントを設定中...";
        SetupEvents();
        yield return new WaitForEndOfFrame();
        
        // ステップ6: カーソル設定
        currentStatus = "カーソルを設定中...";
        SetupCursor();
        yield return new WaitForEndOfFrame();
        
        // ステップ7: テストボタン作成
        currentStatus = "テストボタンを作成中...";
        CreateTestButton();
        yield return new WaitForEndOfFrame();
        
        // 完了
        currentStatus = "修復完了！";
        Debug.Log("✅ [QuickFix] ヒントシーンの修復が完了しました！");
        Debug.Log("🎯 [QuickFix] 赤いテストボタンをクリックして動作確認してください");
        
        // 最終確認
        PerformFinalCheck();
    }
    
    private void EnsureBasicElements()
    {
        Debug.Log("[QuickFix] Canvas と EventSystem を確保中...");
        
        // Canvas
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            GameObject canvasObj = new GameObject("Canvas");
            canvas = canvasObj.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvasObj.AddComponent<CanvasScaler>();
            canvasObj.AddComponent<GraphicRaycaster>();
            Debug.Log("✓ Canvas を作成しました");
        }
        
        // EventSystem
        UnityEngine.EventSystems.EventSystem eventSystem = FindObjectOfType<UnityEngine.EventSystems.EventSystem>();
        if (eventSystem == null)
        {
            GameObject eventObj = new GameObject("EventSystem");
            eventObj.AddComponent<UnityEngine.EventSystems.EventSystem>();
            eventObj.AddComponent<UnityEngine.EventSystems.StandaloneInputModule>();
            Debug.Log("✓ EventSystem を作成しました");
        }
    }
    
    private void EnsureGameHintManager()
    {
        Debug.Log("[QuickFix] GameHintManager を確保中...");
        
        GameHintManager manager = FindObjectOfType<GameHintManager>();
        if (manager == null)
        {
            GameObject managerObj = new GameObject("GameHintManager");
            manager = managerObj.AddComponent<GameHintManager>();
            Debug.Log("✓ GameHintManager を作成しました");
        }
        
        // 強制初期化
        manager.SendMessage("InitializeHintDatabase", SendMessageOptions.DontRequireReceiver);
        Debug.Log("✓ GameHintManager を初期化しました");
    }
    
    private void GenerateUI()
    {
        Debug.Log("[QuickFix] UI を生成中...");
        
        HintUIGenerator generator = FindObjectOfType<HintUIGenerator>();
        if (generator == null)
        {
            GameObject generatorObj = new GameObject("HintUIGenerator");
            generator = generatorObj.AddComponent<HintUIGenerator>();
        }
        
        generator.GenerateHintUI();
        Debug.Log("✓ UI を生成しました");
    }
    
    private void SetupConnections()
    {
        Debug.Log("[QuickFix] UI接続を設定中...");
        
        HintManagerAutoSetup autoSetup = FindObjectOfType<HintManagerAutoSetup>();
        if (autoSetup == null)
        {
            GameObject setupObj = new GameObject("HintManagerAutoSetup");
            autoSetup = setupObj.AddComponent<HintManagerAutoSetup>();
        }
        
        GameHintManager manager = FindObjectOfType<GameHintManager>();
        if (manager != null)
        {
            autoSetup.hintManager = manager;
            autoSetup.AutoSetupHintManager();
            Debug.Log("✓ UI接続を設定しました");
        }
    }
    
    private void SetupEvents()
    {
        Debug.Log("[QuickFix] イベントを設定中...");
        
        GameHintManager manager = FindObjectOfType<GameHintManager>();
        if (manager != null)
        {
            // SetupButtonsメソッドを強制呼び出し
            manager.SendMessage("SetupButtons", SendMessageOptions.DontRequireReceiver);
            Debug.Log("✓ ボタンイベントを設定しました");
        }
    }
    
    private void SetupCursor()
    {
        Debug.Log("[QuickFix] カーソルを設定中...");
        
        Cursor.lockState = CursorLockMode.None;
        Cursor.visible = true;
        Debug.Log("✓ カーソルをUI用に設定しました");
    }
    
    private void CreateTestButton()
    {
        Debug.Log("[QuickFix] テストボタンを作成中...");
        
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null) return;
        
        // 既存のテストボタンを削除
        GameObject existingTest = GameObject.Find("QuickTestButton");
        if (existingTest != null)
        {
            DestroyImmediate(existingTest);
        }
        
        // 新しいテストボタンを作成
        GameObject buttonObj = new GameObject("QuickTestButton");
        buttonObj.transform.SetParent(canvas.transform, false);
        
        RectTransform rect = buttonObj.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.1f, 0.1f);
        rect.anchorMax = new Vector2(0.5f, 0.2f);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        Image image = buttonObj.AddComponent<Image>();
        image.color = new Color(1f, 0.2f, 0.2f, 0.9f); // 明るい赤
        
        Button button = buttonObj.AddComponent<Button>();
        button.onClick.AddListener(() => {
            Debug.Log("🎯 [成功] テストボタンが正常にクリックされました！");
            Debug.Log("🎉 [成功] ボタンイベントは正しく動作しています！");
            TestHintManagerFunctions();
        });
        
        // テキスト
        GameObject textObj = new GameObject("Text");
        textObj.transform.SetParent(buttonObj.transform, false);
        
        Text text = textObj.AddComponent<Text>();
        text.text = "🧪 テストボタン\n(クリックしてください)";
        text.font = UIUtility.GetDefaultFont();
        text.fontSize = 12;
        text.alignment = TextAnchor.MiddleCenter;
        text.color = Color.white;
        
        RectTransform textRect = textObj.GetComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.offsetMin = Vector2.zero;
        textRect.offsetMax = Vector2.zero;
        
        Debug.Log("✓ テストボタンを作成しました");
    }
    
    private void TestHintManagerFunctions()
    {
        Debug.Log("[テスト] GameHintManagerの機能をテスト中...");
        
        GameHintManager manager = FindObjectOfType<GameHintManager>();
        if (manager != null)
        {
            // カテゴリ選択テスト
            manager.SelectCategory(GameHintManager.HintCategory.SymmetricKey);
            Debug.Log("✓ カテゴリ選択機能は動作しています");
            
            // 1秒後にヒント表示テスト
            StartCoroutine(DelayedHintTest(manager));
        }
        else
        {
            Debug.LogError("❌ GameHintManagerが見つかりません");
        }
    }
    
    private System.Collections.IEnumerator DelayedHintTest(GameHintManager manager)
    {
        yield return new WaitForSeconds(1f);
        
        manager.ShowHint(0);
        Debug.Log("✓ ヒント表示機能は動作しています");
        
        yield return new WaitForSeconds(1f);
        
        manager.GoBack();
        Debug.Log("✓ 戻る機能は動作しています");
        
        Debug.Log("🎊 [完了] すべての基本機能が正常に動作しています！");
    }
    
    private void PerformFinalCheck()
    {
        Debug.Log("[最終確認] システムの整合性をチェック中...");
        
        Canvas canvas = FindObjectOfType<Canvas>();
        UnityEngine.EventSystems.EventSystem eventSystem = FindObjectOfType<UnityEngine.EventSystems.EventSystem>();
        GameHintManager manager = FindObjectOfType<GameHintManager>();
        Button[] buttons = FindObjectsOfType<Button>();
        
        Debug.Log($"📊 [確認結果]");
        Debug.Log($"  Canvas: {(canvas != null ? "✅" : "❌")}");
        Debug.Log($"  EventSystem: {(eventSystem != null ? "✅" : "❌")}");
        Debug.Log($"  GameHintManager: {(manager != null ? "✅" : "❌")}");
        Debug.Log($"  Buttons: {buttons.Length} 個");
        
        if (canvas != null && eventSystem != null && manager != null && buttons.Length > 0)
        {
            Debug.Log("🎉 [最終結果] ヒントシーンは正常に動作する準備ができました！");
            Debug.Log("💡 [次のステップ] 赤いテストボタンをクリックして動作確認してください");
        }
        else
        {
            Debug.LogWarning("⚠️ [注意] まだ問題がある可能性があります");
        }
    }
    
    /// <summary>
    /// 緊急リセット用
    /// </summary>
    [ContextMenu("Emergency Reset")]
    public void EmergencyReset()
    {
        Debug.Log("🚨 [緊急] 緊急リセットを実行中...");
        
        // すべてのGameObjectを削除して最初から
        GameHintManager[] managers = FindObjectsOfType<GameHintManager>();
        foreach (var manager in managers)
        {
            if (manager != this.GetComponent<GameHintManager>())
            {
                DestroyImmediate(manager.gameObject);
            }
        }
        
        HintUIGenerator[] generators = FindObjectsOfType<HintUIGenerator>();
        foreach (var generator in generators)
        {
            DestroyImmediate(generator.gameObject);
        }
        
        Debug.Log("🔄 [緊急] リセット完了。もう一度 Execute Quick Fix を実行してください");
        currentStatus = "リセット完了 - 再実行してください";
    }
}
