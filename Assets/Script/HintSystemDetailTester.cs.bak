using UnityEngine;
using UnityEngine.UI;
using UnityEngine.EventSystems;
using System.Collections.Generic;

/// <summary>
/// ヒント詳細表示の問題を特定するためのテストツール
/// </summary>
public class HintSystemDetailTester : MonoBehaviour
{
    [Header("テスト設定")]
    public KeyCode testKey = KeyCode.F1;
    
    private bool isTestingActive = false;
    private RealHintSystem realHintSystem;
    private Canvas testCanvas;
    private GameObject testContainer;
    
    void Start()
    {
        Debug.Log("[HintSystemDetailTester] Tester initialized. Press F1 to start detail display test.");
    }
    
    void Update()
    {
        if (Input.GetKeyDown(testKey))
        {
            if (!isTestingActive)
            {
                StartDetailTest();
            }
            else
            {
                StopDetailTest();
            }
        }
    }
    
    void StartDetailTest()
    {
        Debug.Log("[HintSystemDetailTester] Starting detail display test...");
        isTestingActive = true;
        
        // RealHintSystemを探す
        realHintSystem = FindObjectOfType<RealHintSystem>();
        if (realHintSystem == null)
        {
            Debug.LogError("[HintSystemDetailTester] RealHintSystem not found! Creating one...");
            GameObject hintSystemObj = new GameObject("TestRealHintSystem");
            realHintSystem = hintSystemObj.AddComponent<RealHintSystem>();
        }
        
        // 直接ヒント詳細表示をテスト
        TestDirectHintDisplay();
        
        // UI要素の存在確認
        CheckUIElements();
    }
    
    void TestDirectHintDisplay()
    {
        Debug.Log("[HintSystemDetailTester] Testing direct hint detail display...");
        
        // カーソル状態を設定
        Cursor.lockState = CursorLockMode.None;
        Cursor.visible = true;
        
        // RealHintSystemを強制的に初期化
        if (realHintSystem != null)
        {
            // プライベートメソッドを呼び出すためのReflection使用
            var methodInfo = typeof(RealHintSystem).GetMethod("InitializeHintDatabase", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (methodInfo != null)
            {
                methodInfo.Invoke(realHintSystem, null);
                Debug.Log("[HintSystemDetailTester] Hint database initialized via reflection.");
            }
            
            // ヒントシステムを表示
            realHintSystem.ShowHintSystem();
            
            // 少し遅延してからカテゴリ表示
            Invoke("ShowTestCategory", 0.5f);
        }
    }
    
    void ShowTestCategory()
    {
        Debug.Log("[HintSystemDetailTester] Showing test category...");
        
        if (realHintSystem != null)
        {
            // 共通鍵暗号カテゴリを表示
            var methodInfo = typeof(RealHintSystem).GetMethod("ShowCategoryHints", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (methodInfo != null)
            {
                methodInfo.Invoke(realHintSystem, new object[] { "symmetric", "共通鍵暗号" });
                Debug.Log("[HintSystemDetailTester] Category hints displayed via reflection.");
                
                // さらに遅延してからヒント詳細表示
                Invoke("ShowTestHintDetail", 1.0f);
            }
        }
    }
    
    void ShowTestHintDetail()
    {
        Debug.Log("[HintSystemDetailTester] Showing test hint detail...");
        
        if (realHintSystem != null)
        {
            // ヒント詳細を表示（最初のヒント）
            var methodInfo = typeof(RealHintSystem).GetMethod("ShowHintDetail", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (methodInfo != null)
            {
                methodInfo.Invoke(realHintSystem, new object[] { 0 });
                Debug.Log("[HintSystemDetailTester] Hint detail displayed via reflection.");
                
                // UI要素の確認
                Invoke("CheckHintDetailUI", 0.5f);
            }
        }
    }
    
    void CheckHintDetailUI()
    {
        Debug.Log("[HintSystemDetailTester] Checking hint detail UI elements...");
        
        // RealHintSystemのhintDetailAreaフィールドを確認
        var hintDetailAreaField = typeof(RealHintSystem).GetField("hintDetailArea", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        
        if (hintDetailAreaField != null && realHintSystem != null)
        {
            GameObject hintDetailArea = (GameObject)hintDetailAreaField.GetValue(realHintSystem);
            if (hintDetailArea != null)
            {
                Debug.Log($"[HintSystemDetailTester] HintDetailArea found: {hintDetailArea.name}");
                Debug.Log($"[HintSystemDetailTester] Active: {hintDetailArea.activeInHierarchy}");
                Debug.Log($"[HintSystemDetailTester] Child count: {hintDetailArea.transform.childCount}");
                
                // 子要素の確認
                for (int i = 0; i < hintDetailArea.transform.childCount; i++)
                {
                    Transform child = hintDetailArea.transform.GetChild(i);
                    Debug.Log($"[HintSystemDetailTester] Child {i}: {child.name} (Active: {child.gameObject.activeInHierarchy})");
                    
                    Text textComponent = child.GetComponent<Text>();
                    if (textComponent != null)
                    {
                        Debug.Log($"[HintSystemDetailTester] Text content: '{textComponent.text}'");
                        Debug.Log($"[HintSystemDetailTester] Text color: {textComponent.color}");
                        Debug.Log($"[HintSystemDetailTester] Font: {textComponent.font?.name}");
                    }
                }
            }
            else
            {
                Debug.LogWarning("[HintSystemDetailTester] HintDetailArea is null!");
            }
        }
        else
        {
            Debug.LogError("[HintSystemDetailTester] Could not access hintDetailArea field!");
        }
    }
    
    void CheckUIElements()
    {
        Debug.Log("[HintSystemDetailTester] Checking UI elements...");
        
        // Canvas確認
        Canvas[] canvases = FindObjectsOfType<Canvas>();
        Debug.Log($"[HintSystemDetailTester] Found {canvases.Length} canvases:");
        foreach (Canvas canvas in canvases)
        {
            Debug.Log($"[HintSystemDetailTester] Canvas: {canvas.name} (Enabled: {canvas.enabled})");
        }
        
        // EventSystem確認
        EventSystem eventSystem = FindObjectOfType<EventSystem>();
        if (eventSystem != null)
        {
            Debug.Log($"[HintSystemDetailTester] EventSystem found: {eventSystem.name} (Enabled: {eventSystem.enabled})");
        }
        else
        {
            Debug.LogWarning("[HintSystemDetailTester] No EventSystem found!");
        }
        
        // GraphicRaycaster確認
        GraphicRaycaster[] raycasters = FindObjectsOfType<GraphicRaycaster>();
        Debug.Log($"[HintSystemDetailTester] Found {raycasters.Length} GraphicRaycasters:");
        foreach (GraphicRaycaster raycaster in raycasters)
        {
            Debug.Log($"[HintSystemDetailTester] Raycaster: {raycaster.name} (Enabled: {raycaster.enabled})");
        }
    }
    
    void StopDetailTest()
    {
        Debug.Log("[HintSystemDetailTester] Stopping detail test...");
        isTestingActive = false;
        
        if (realHintSystem != null)
        {
            var methodInfo = typeof(RealHintSystem).GetMethod("ReturnToMainGame", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (methodInfo != null)
            {
                methodInfo.Invoke(realHintSystem, null);
            }
        }
    }
    
    void OnGUI()
    {
        if (isTestingActive)
        {
            GUI.Label(new Rect(10, 10, 400, 30), "Hint Detail Test Active - Press F1 to stop");
            
            if (GUI.Button(new Rect(10, 50, 200, 30), "Test Hint Detail Again"))
            {
                ShowTestHintDetail();
            }
            
            if (GUI.Button(new Rect(10, 90, 200, 30), "Check UI Elements"))
            {
                CheckUIElements();
            }
        }
        else
        {
            GUI.Label(new Rect(10, 10, 300, 30), "Press F1 to start hint detail test");
        }
    }
}
