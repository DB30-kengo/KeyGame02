using UnityEngine;
using UnityEngine.UI;
using System.Collections;

/// <summary>
/// 通知スタイルのヒント表示システム
/// 画面端からスライドインして自動で消える、ゲームの邪魔にならないヒント
/// </summary>
public class NotificationHintSystem : MonoBehaviour
{
    [Header("表示設定")]
    public KeyCode hintKey = KeyCode.H;
    public float slideSpeed = 500f;
    public float displayDuration = 4f;
    public AnimationCurve slideCurve = AnimationCurve.EaseInOut(0, 0, 1, 1);
    
    [Header("見た目")]
    public Color backgroundColor = new Color(0.1f, 0.1f, 0.1f, 0.9f);
    public Color textColor = Color.white;
    public Color accentColor = Color.cyan;
    
    private GameObject notificationPanel;
    private Text hintText;
    private Image backgroundImage;
    private RectTransform panelRect;
    private CanvasGroup canvasGroup;
    
    private bool isShowing = false;
    private int currentHintIndex = 0;
    
    // コンパクトなヒント集
    private string[] compactHints = {
        "💡 基本操作\nWASD: 移動 | マウス: 視点\nクリック: 選択・回答",
        
        "🔐 共通鍵暗号\n同じ鍵で暗号化・復号化\n例: AES, DES",
        
        "🗝️ 公開鍵暗号\n公開鍵と秘密鍵のペア\n例: RSA, ECC",
        
        "🔗 ハイブリッド暗号\n共通鍵 + 公開鍵の組み合わせ\n例: SSL/TLS",
        
        "🎯 ゲームのコツ\n正解で次へ進行\n間違えても再挑戦可能",
        
        "⚡ 暗号の特徴\nAES: 高速・安全\nRSA: 鍵交換に最適",
        
        "🛡️ セキュリティ\n暗号化で情報を保護\n現代社会の基盤技術"
    };
    
    void Start()
    {
        CreateNotificationUI();
        Debug.Log($"[NotificationHintSystem] 通知型ヒントシステム準備完了 - {hintKey}キーで表示");
    }
    
    void Update()
    {
        if (Input.GetKeyDown(hintKey))
        {
            if (isShowing)
            {
                ShowNextHint();
            }
            else
            {
                ShowCurrentHint();
            }
        }
    }
    
    void CreateNotificationUI()
    {
        // 専用Canvas作成
        GameObject canvasObj = new GameObject("NotificationCanvas");
        Canvas canvas = canvasObj.AddComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        canvas.sortingOrder = 200; // 最前面
        
        CanvasScaler scaler = canvasObj.AddComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920, 1080);
        
        // 通知パネル作成
        notificationPanel = new GameObject("NotificationPanel");
        notificationPanel.transform.SetParent(canvas.transform, false);
        
        panelRect = notificationPanel.AddComponent<RectTransform>();
        panelRect.sizeDelta = new Vector2(350, 120);
        panelRect.anchorMin = new Vector2(1, 1); // 右上基準
        panelRect.anchorMax = new Vector2(1, 1);
        panelRect.anchoredPosition = new Vector2(400, -60); // 最初は画面外
        
        // 背景
        backgroundImage = notificationPanel.AddComponent<Image>();
        backgroundImage.color = backgroundColor;
        
        // 角丸風エフェクト用の外枠
        GameObject border = new GameObject("Border");
        border.transform.SetParent(notificationPanel.transform, false);
        RectTransform borderRect = border.AddComponent<RectTransform>();
        borderRect.anchorMin = Vector2.zero;
        borderRect.anchorMax = Vector2.one;
        borderRect.offsetMin = Vector2.zero;
        borderRect.offsetMax = Vector2.zero;
        
        Image borderImage = border.AddComponent<Image>();
        borderImage.color = accentColor;
        
        // 内側パネル（少し小さくして枠効果）
        GameObject innerPanel = new GameObject("InnerPanel");
        innerPanel.transform.SetParent(border.transform, false);
        RectTransform innerRect = innerPanel.AddComponent<RectTransform>();
        innerRect.anchorMin = Vector2.zero;
        innerRect.anchorMax = Vector2.one;
        innerRect.offsetMin = new Vector2(2, 2);
        innerRect.offsetMax = new Vector2(-2, -2);
        
        Image innerImage = innerPanel.AddComponent<Image>();
        innerImage.color = backgroundColor;
        
        // テキスト
        GameObject textObj = new GameObject("HintText");
        textObj.transform.SetParent(innerPanel.transform, false);
        
        hintText = textObj.AddComponent<Text>();
        hintText.font = GetSafeFont();
        hintText.fontSize = 14;
        hintText.color = textColor;
        hintText.alignment = TextAnchor.UpperLeft;
        hintText.lineSpacing = 1.1f;
        
        RectTransform textRect = textObj.GetComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.offsetMin = new Vector2(10, 10);
        textRect.offsetMax = new Vector2(-10, -10);
        
        // フェード用
        canvasGroup = notificationPanel.AddComponent<CanvasGroup>();
        canvasGroup.alpha = 1f;
        
        Debug.Log("[NotificationHintSystem] 通知UI作成完了");
    }
    
    public void ShowCurrentHint()
    {
        if (isShowing) return;
        
        hintText.text = compactHints[currentHintIndex];
        StartCoroutine(ShowNotificationCoroutine());
    }
    
    void ShowNextHint()
    {
        currentHintIndex = (currentHintIndex + 1) % compactHints.Length;
        hintText.text = compactHints[currentHintIndex];
        
        // 既に表示中の場合は位置をリセット
        if (isShowing)
        {
            StopAllCoroutines();
            StartCoroutine(ShowNotificationCoroutine());
        }
    }
    
    IEnumerator ShowNotificationCoroutine()
    {
        isShowing = true;
        
        // スライドイン
        float slideTime = 0.8f;
        Vector2 targetPos = new Vector2(-175, -60); // 画面内
        Vector2 startPos = new Vector2(400, -60);   // 画面外
        
        float elapsedTime = 0f;
        while (elapsedTime < slideTime)
        {
            float progress = elapsedTime / slideTime;
            float curveValue = slideCurve.Evaluate(progress);
            panelRect.anchoredPosition = Vector2.Lerp(startPos, targetPos, curveValue);
            elapsedTime += Time.deltaTime;
            yield return null;
        }
        panelRect.anchoredPosition = targetPos;
        
        // 表示時間待機
        yield return new WaitForSeconds(displayDuration);
        
        // スライドアウト
        elapsedTime = 0f;
        while (elapsedTime < slideTime)
        {
            float progress = elapsedTime / slideTime;
            float curveValue = slideCurve.Evaluate(progress);
            panelRect.anchoredPosition = Vector2.Lerp(targetPos, startPos, curveValue);
            elapsedTime += Time.deltaTime;
            yield return null;
        }
        panelRect.anchoredPosition = startPos;
        
        isShowing = false;
    }
    
    Font GetSafeFont()
    {
        Font font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        if (font == null)
        {
            font = Resources.GetBuiltinResource<Font>("Arial.ttf");
        }
        return font;
    }
    
    /// <summary>
    /// 特定のヒントを即座に表示
    /// </summary>
    public void ShowCustomNotification(string message)
    {
        if (isShowing)
        {
            StopAllCoroutines();
        }
        
        hintText.text = message;
        StartCoroutine(ShowNotificationCoroutine());
    }
    
    /// <summary>
    /// 操作ヒントを表示
    /// </summary>
    public void ShowControlHint()
    {
        ShowCustomNotification("💡 基本操作\nWASD: 移動 | マウス: 視点\nH: ヒント | ESC: メニュー");
    }
    
    /// <summary>
    /// 暗号ヒントを表示
    /// </summary>
    public void ShowCryptoHint()
    {
        ShowCustomNotification("🔐 暗号の種類\n共通鍵: AES, DES\n公開鍵: RSA, ECC\nハイブリッド: SSL/TLS");
    }
    
    void OnGUI()
    {
        // 左下に控えめな操作ガイド
        GUIStyle style = new GUIStyle(GUI.skin.label);
        style.fontSize = 11;
        style.normal.textColor = new Color(1, 1, 1, 0.6f);
        
        GUI.Label(new Rect(10, Screen.height - 30, 150, 25), 
                 $"{hintKey}: ヒント通知", style);
    }
}
