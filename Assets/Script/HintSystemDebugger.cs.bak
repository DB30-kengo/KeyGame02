using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;

/// <summary>
/// ヒントシステムの詳細動作確認とトラブルシューティング
/// </summary>
public class HintSystemDebugger : MonoBehaviour
{
    [Header("Debug Settings")]
    [Tooltip("自動デバッグ実行")]
    public bool autoDebug = true;
    
    [Tooltip("詳細ログ表示")]
    public bool verboseLogging = true;
    
    [Header("Debug UI")]
    public Text debugText;
    public Button testButton;
    
    private RealHintSystem realHintSystem;
    private string debugLog = "";
    
    void Start()
    {
        CreateDebugUI();
        
        if (autoDebug)
        {
            StartDebugging();
        }
    }
    
    void Update()
    {
        // デバッグショートカット
        if (Input.GetKeyDown(KeyCode.F9))
        {
            DebugHintSystem();
        }
        
        if (Input.GetKeyDown(KeyCode.F10))
        {
            TestHintNavigation();
        }
        
        if (Input.GetKeyDown(KeyCode.F11))
        {
            ForceCreateRealHintSystem();
        }
        
        if (Input.GetKeyDown(KeyCode.F12))
        {
            TestHintContent();
        }
    }
    
    /// <summary>
    /// デバッグUIを作成
    /// </summary>
    private void CreateDebugUI()
    {
        // Canvas確保
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            GameObject canvasObj = new GameObject("DebugCanvas");
            canvas = canvasObj.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvas.sortingOrder = 1000; // 最前面
            canvasObj.AddComponent<CanvasScaler>();
            canvasObj.AddComponent<GraphicRaycaster>();
        }
        
        // デバッグテキスト作成
        if (debugText == null)
        {
            GameObject debugObj = new GameObject("HintSystemDebugText");
            debugObj.transform.SetParent(canvas.transform, false);
            
            RectTransform debugRect = debugObj.AddComponent<RectTransform>();
            debugRect.anchorMin = new Vector2(0.55f, 0.02f);
            debugRect.anchorMax = new Vector2(0.98f, 0.6f);
            debugRect.offsetMin = Vector2.zero;
            debugRect.offsetMax = Vector2.zero;
            
            // 背景
            Image debugBg = debugObj.AddComponent<Image>();
            debugBg.color = new Color(0f, 0f, 0f, 0.7f);
            
            debugText = debugObj.AddComponent<Text>();
            debugText.font = UIUtility.GetDefaultFont();
            debugText.fontSize = 10;
            debugText.color = Color.green;
            debugText.alignment = TextAnchor.UpperLeft;
            debugText.text = "Hint System Debugger\nF9: Debug System\nF10: Test Navigation\nF11: Force Create\nF12: Test Content";
        }
        
        // テストボタン作成
        if (testButton == null)
        {
            GameObject buttonObj = new GameObject("DebugTestButton");
            buttonObj.transform.SetParent(canvas.transform, false);
            
            RectTransform buttonRect = buttonObj.AddComponent<RectTransform>();
            buttonRect.anchorMin = new Vector2(0.55f, 0.65f);
            buttonRect.anchorMax = new Vector2(0.75f, 0.75f);
            buttonRect.offsetMin = Vector2.zero;
            buttonRect.offsetMax = Vector2.zero;
            
            testButton = buttonObj.AddComponent<Button>();
            Image buttonImage = buttonObj.AddComponent<Image>();
            buttonImage.color = new Color(0.8f, 0.2f, 0.2f, 0.8f);
            
            // ボタンテキスト
            GameObject textObj = new GameObject("Text");
            textObj.transform.SetParent(buttonObj.transform, false);
            
            Text buttonText = textObj.AddComponent<Text>();
            buttonText.text = "🔍 Debug";
            buttonText.font = UIUtility.GetDefaultFont();
            buttonText.fontSize = 14;
            buttonText.color = Color.white;
            buttonText.alignment = TextAnchor.MiddleCenter;
            
            RectTransform textRect = textObj.GetComponent<RectTransform>();
            textRect.anchorMin = Vector2.zero;
            textRect.anchorMax = Vector2.one;
            textRect.offsetMin = Vector2.zero;
            textRect.offsetMax = Vector2.zero;
            
            // ボタンイベント
            testButton.onClick.AddListener(DebugHintSystem);
        }
    }
    
    /// <summary>
    /// デバッグ開始
    /// </summary>
    [ContextMenu("Start Debugging")]
    public void StartDebugging()
    {
        AddDebugLog("=== ヒントシステムデバッグ開始 ===");
        
        DebugHintSystem();
    }
    
    /// <summary>
    /// ヒントシステムをデバッグ
    /// </summary>
    [ContextMenu("Debug Hint System")]
    public void DebugHintSystem()
    {
        AddDebugLog("--- ヒントシステム状態確認 ---");
        
        // RealHintSystemの確認
        realHintSystem = FindObjectOfType<RealHintSystem>();
        if (realHintSystem == null)
        {
            AddDebugLog("❌ RealHintSystem が見つかりません");
            
            // HintSceneAutoSetupを確認
            HintSceneAutoSetup autoSetup = FindObjectOfType<HintSceneAutoSetup>();
            if (autoSetup == null)
            {
                AddDebugLog("❌ HintSceneAutoSetup も見つかりません");
                AddDebugLog("→ F11で強制作成を試してください");
            }
            else
            {
                AddDebugLog("✅ HintSceneAutoSetup は存在");
            }
        }
        else
        {
            AddDebugLog("✅ RealHintSystem 発見");
            DebugRealHintSystemDetails();
        }
        
        // UI構成要素の確認
        DebugUIComponents();
        
        // シーン情報の確認
        DebugSceneInfo();
    }
    
    /// <summary>
    /// RealHintSystemの詳細をデバッグ
    /// </summary>
    private void DebugRealHintSystemDetails()
    {
        if (realHintSystem == null) return;
        
        AddDebugLog("--- RealHintSystem 詳細 ---");
        AddDebugLog($"mainCanvas: {(realHintSystem.mainCanvas != null ? "✅" : "❌")}");
        AddDebugLog($"returnSceneName: {realHintSystem.returnSceneName}");
        
        // ヒントデータベースの確認（リフレクション使用）
        var databaseField = typeof(RealHintSystem).GetField("hintDatabase", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        
        if (databaseField != null)
        {
            var database = databaseField.GetValue(realHintSystem);
            if (database != null)
            {
                AddDebugLog("✅ ヒントデータベース初期化済み");
            }
            else
            {
                AddDebugLog("❌ ヒントデータベース未初期化");
            }
        }
    }
    
    /// <summary>
    /// UI構成要素をデバッグ
    /// </summary>
    private void DebugUIComponents()
    {
        AddDebugLog("--- UI構成要素確認 ---");
        
        Canvas[] canvases = FindObjectsOfType<Canvas>();
        AddDebugLog($"Canvas数: {canvases.Length}");
        
        UnityEngine.EventSystems.EventSystem eventSystem = FindObjectOfType<UnityEngine.EventSystems.EventSystem>();
        AddDebugLog($"EventSystem: {(eventSystem != null ? "✅" : "❌")}");
        
        Button[] buttons = FindObjectsOfType<Button>();
        AddDebugLog($"Button数: {buttons.Length}");
        
        Text[] texts = FindObjectsOfType<Text>();
        AddDebugLog($"Text数: {texts.Length}");
        
        // RealHintSystemContainerの確認
        GameObject container = GameObject.Find("RealHintSystemContainer");
        AddDebugLog($"RealHintSystemContainer: {(container != null ? "✅" : "❌")}");
    }
    
    /// <summary>
    /// シーン情報をデバッグ
    /// </summary>
    private void DebugSceneInfo()
    {
        AddDebugLog("--- シーン情報 ---");
        
        string currentScene = SceneManager.GetActiveScene().name;
        AddDebugLog($"現在のシーン: {currentScene}");
        
        // PlayerPrefsの確認
        if (PlayerPrefs.HasKey("PreviousScene"))
        {
            string previousScene = PlayerPrefs.GetString("PreviousScene");
            AddDebugLog($"前のシーン: {previousScene}");
        }
        else
        {
            AddDebugLog("前のシーン情報なし");
        }
        
        // カーソル状態の確認
        AddDebugLog($"Cursor - Visible: {Cursor.visible}, Lock: {Cursor.lockState}");
    }
    
    /// <summary>
    /// ヒントナビゲーションをテスト
    /// </summary>
    [ContextMenu("Test Hint Navigation")]
    public void TestHintNavigation()
    {
        AddDebugLog("--- ナビゲーションテスト ---");
        
        if (realHintSystem == null)
        {
            realHintSystem = FindObjectOfType<RealHintSystem>();
        }
        
        if (realHintSystem == null)
        {
            AddDebugLog("❌ RealHintSystemが見つからないためテスト不可");
            return;
        }
        
        // カテゴリボタンの存在確認
        Button[] buttons = FindObjectsOfType<Button>();
        AddDebugLog($"発見されたボタン数: {buttons.Length}");
        
        foreach (Button button in buttons)
        {
            if (button.name.Contains("CategoryButton"))
            {
                AddDebugLog($"✅ カテゴリボタン発見: {button.name}");
                
                // ボタンクリックをテスト
                AddDebugLog("→ ボタンクリックをシミュレート");
                button.onClick.Invoke();
                break;
            }
        }
    }
    
    /// <summary>
    /// RealHintSystemを強制作成
    /// </summary>
    [ContextMenu("Force Create RealHintSystem")]
    public void ForceCreateRealHintSystem()
    {
        AddDebugLog("--- RealHintSystem 強制作成 ---");
        
        // 既存のRealHintSystemをチェック
        RealHintSystem existing = FindObjectOfType<RealHintSystem>();
        if (existing != null)
        {
            AddDebugLog("⚠️ 既存のRealHintSystemを削除");
            DestroyImmediate(existing.gameObject);
        }
        
        // 新しいRealHintSystemを作成
        GameObject hintSystemObj = new GameObject("RealHintSystem (Debug)");
        realHintSystem = hintSystemObj.AddComponent<RealHintSystem>();
        realHintSystem.returnSceneName = PlayerPrefs.GetString("PreviousScene", "Chapter_game");
        
        AddDebugLog("✅ RealHintSystem を強制作成しました");
        AddDebugLog("→ システムが自動的に初期化されます");
    }
    
    /// <summary>
    /// ヒント内容をテスト
    /// </summary>
    [ContextMenu("Test Hint Content")]
    public void TestHintContent()
    {
        AddDebugLog("--- ヒント内容テスト ---");
        
        if (realHintSystem == null)
        {
            AddDebugLog("❌ RealHintSystemが見つかりません");
            return;
        }
        
        // ヒントデータベースへのアクセス（リフレクション）
        var databaseField = typeof(RealHintSystem).GetField("hintDatabase", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        
        if (databaseField != null)
        {
            var database = databaseField.GetValue(realHintSystem);
            if (database != null)
            {
                AddDebugLog("✅ ヒントデータベースアクセス成功");
                
                // データベース内容を確認（デバッグ用）
                var dictType = database.GetType();
                var countProperty = dictType.GetProperty("Count");
                if (countProperty != null)
                {
                    int count = (int)countProperty.GetValue(database);
                    AddDebugLog($"ヒントカテゴリ数: {count}");
                }
            }
        }
    }
    
    /// <summary>
    /// ゲームに戻る機能をテスト
    /// </summary>
    [ContextMenu("Test Return To Game")]
    public void TestReturnToGame()
    {
        AddDebugLog("--- ゲーム復帰テスト ---");
        
        if (realHintSystem == null)
        {
            AddDebugLog("❌ RealHintSystemが見つかりません");
            return;
        }
        
        AddDebugLog("→ ReturnToMainGame() を実行");
        realHintSystem.ReturnToMainGame();
    }
    
    /// <summary>
    /// デバッグログを追加
    /// </summary>
    private void AddDebugLog(string message)
    {
        debugLog += message + "\n";
        
        if (debugText != null)
        {
            // 最新の20行のみを表示
            string[] lines = debugLog.Split('\n');
            if (lines.Length > 20)
            {
                debugLog = string.Join("\n", lines, lines.Length - 20, 20);
            }
            
            debugText.text = debugLog;
        }
        
        if (verboseLogging)
        {
            Debug.Log($"[HintSystemDebugger] {message}");
        }
    }
    
    /// <summary>
    /// デバッグログをクリア
    /// </summary>
    [ContextMenu("Clear Debug Log")]
    public void ClearDebugLog()
    {
        debugLog = "デバッグログクリア\n";
        if (debugText != null)
        {
            debugText.text = debugLog;
        }
    }
}
